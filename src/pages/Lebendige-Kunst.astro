---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactCard from "../components/ContactCard.astro";
import { getSingle } from "../lib/pageContent";
import { safeInlineJson } from "../lib/safeMarkup";
import { getTeacherByLastName } from "../lib/teachers";

const page: any = await getSingle("pageLebendigeKunst");
const lange = await getTeacherByLastName("Lange");
const wolle = await getTeacherByLastName("Wolle");

type GalleryImage = { image: string; imageAlt: string };
type GalleryItem = {
  title?: string;
  caption?: string;
  images: GalleryImage[];
};

// Backward-Kompatibilität: alte items mit `image`/`imageAlt` direkt am Item
// werden in eine images-Liste mit einem Eintrag normalisiert.
const rawItems: any[] = page.gallery?.items ?? [];
const galleryItems: GalleryItem[] = rawItems.map((it) => {
  if (Array.isArray(it.images) && it.images.length > 0) {
    return { title: it.title, caption: it.caption, images: it.images };
  }
  if (it.image) {
    return {
      title: it.title,
      caption: it.caption,
      images: [{ image: it.image, imageAlt: it.imageAlt ?? "" }],
    };
  }
  return { title: it.title, caption: it.caption, images: [] };
}).filter((it) => it.images.length > 0);

// Flat-Liste für die Lightbox: jedes Bild bekommt seinen Beitrag-Kontext
// mit, plus seine Position innerhalb des Beitrags ("Bild 2 von 5").
type FlatImage = {
  image: string;
  imageAlt: string;
  title: string;
  caption: string;
  posInItem: number;
  totalInItem: number;
};
const flatImages: FlatImage[] = galleryItems.flatMap((item) =>
  item.images.map((img, imgIdx) => ({
    image: img.image,
    imageAlt: img.imageAlt,
    title: item.title ?? "",
    caption: item.caption ?? "",
    posInItem: imgIdx + 1,
    totalInItem: item.images.length,
  }))
);

// Pro Card: Index des ersten Bildes in der Flat-Liste.
// Klick auf Card öffnet Lightbox dort.
const firstImageIndices: number[] = [];
let runningIndex = 0;
for (const it of galleryItems) {
  firstImageIndices.push(runningIndex);
  runningIndex += it.images.length;
}
---
<BaseLayout title="Lebendige Kunst · UNESCO-Schule Essen">
<style is:global>
  /* ---------- Lebendige Kunst ---------- */
  .lk-intro{background:var(--creme);padding:var(--space-section) 0;}
  .lk-intro-grid{
    display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);
    gap:64px;align-items:start;
  }
  .lk-intro .eyebrow{display:block;margin-bottom:14px;}
  .lk-intro h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.4vw,44px);line-height:1.1;
    color:var(--petrol);letter-spacing:-0.015em;margin:0;
  }
  .lk-intro p{
    font-family:var(--sans);font-size:17px;line-height:1.7;color:var(--tinte);
    margin:0;
  }

  /* Manifest-Sektion: „Kunst an der UNESCO-Schule" */
  .lk-manifest{
    background:var(--offwhite);
    padding:var(--space-section) 0;
    border-top:1px solid var(--hairline);
  }
  .lk-manifest-grid{
    display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);
    gap:64px;align-items:start;
  }
  .lk-manifest h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.4vw,44px);line-height:1.1;
    color:var(--petrol);letter-spacing:-0.015em;margin:0;
  }
  .lk-manifest .eyebrow{display:block;margin-bottom:14px;}
  .lk-manifest .body p{
    font-family:var(--sans);font-size:17px;line-height:1.7;color:var(--tinte);
    margin:0 0 16px;
  }
  .lk-manifest .body p:last-child{margin-bottom:0;}
  .lk-manifest blockquote{
    margin:28px 0;
    padding:20px 24px;
    background:rgba(212,165,116,0.14);
    border-left:3px solid var(--gold);
    font-family:var(--serif);font-style:italic;font-weight:500;
    font-size:clamp(20px,2.2vw,26px);line-height:1.35;
    color:var(--petrol);letter-spacing:-0.005em;
  }
  .lk-manifest blockquote cite{
    display:block;margin-top:10px;
    font-family:var(--sans);font-style:normal;font-weight:600;font-size:11.5px;
    letter-spacing:0.16em;text-transform:uppercase;color:var(--bordeaux);
  }

  /* Ansprechpartner */
  .lk-contacts{
    background:var(--creme);padding:var(--space-section) 0;
    border-top:1px solid var(--hairline);
  }
  .lk-contacts .head{max-width:680px;margin:0 0 40px;}
  .lk-contacts .head .eyebrow{display:block;margin-bottom:14px;}
  .lk-contacts .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(28px,2.8vw,36px);line-height:1.15;letter-spacing:-0.01em;
    color:var(--petrol);margin:0;
  }
  .lk-contacts-grid{
    display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;
    max-width:780px;
  }

  /* Galerie */
  .lk-gallery{background:var(--offwhite);padding:var(--space-section) 0;}
  .lk-gallery .head{max-width:780px;margin:0 0 56px;}
  .lk-gallery .head .eyebrow{display:block;margin-bottom:14px;}
  .lk-gallery .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.2vw,44px);line-height:1.15;letter-spacing:-0.015em;
    color:var(--petrol);margin:0 0 16px;
  }
  .lk-gallery .head p{
    font-family:var(--sans);font-size:17px;line-height:1.65;color:var(--stein);
    max-width:680px;margin:0;
  }
  .lk-gallery-grid{
    display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;
    list-style:none;padding:0;margin:0;
  }
  .lk-gallery-card{
    appearance:none;background:#fff;border:1px solid var(--hairline);
    border-top:var(--card-accent-width) solid var(--petrol);
    padding:0;width:100%;text-align:left;cursor:pointer;
    display:flex;flex-direction:column;
    transition:transform var(--transition), box-shadow var(--transition);
    color:inherit;font:inherit;
  }
  .lk-gallery-card:hover,
  .lk-gallery-card:focus-visible{
    transform:translateY(var(--card-hover-lift));
    box-shadow:0 16px 40px -22px rgba(14,77,79,0.3);
    outline:none;
  }
  .lk-gallery-card:focus-visible{outline:2px solid var(--petrol);outline-offset:3px;}
  @media (prefers-reduced-motion: reduce){
    .lk-gallery-card:hover,.lk-gallery-card:focus-visible{transform:none;}
  }
  .lk-gallery-card .media{
    aspect-ratio:4/3;overflow:hidden;background:var(--creme);
    position:relative;
  }
  .lk-gallery-card .media img{
    width:100%;height:100%;object-fit:cover;display:block;
    transition:transform var(--transition-slow);
  }
  .lk-gallery-card:hover .media img{transform:scale(1.02);}
  @media (prefers-reduced-motion: reduce){
    .lk-gallery-card:hover .media img{transform:none;}
  }
  /* Multi-Bild-Badge */
  .lk-gallery-card .multi-badge{
    position:absolute;top:12px;right:12px;
    background:rgba(11,42,43,0.78);color:var(--creme);
    border:1px solid rgba(245,239,231,0.25);
    padding:5px 10px;border-radius:999px;
    font-family:var(--sans);font-size:12px;font-weight:600;
    letter-spacing:0.04em;
    display:inline-flex;align-items:center;gap:6px;
    backdrop-filter:blur(4px);
    -webkit-backdrop-filter:blur(4px);
  }
  .lk-gallery-card .multi-badge svg{width:13px;height:13px;}
  .lk-gallery-card .body{
    padding:var(--card-padding);
    display:flex;flex-direction:column;gap:8px;
  }
  .lk-gallery-card h3{
    font-family:var(--serif);font-weight:500;font-size:20px;line-height:1.25;
    color:var(--petrol);letter-spacing:-0.008em;margin:0;
  }
  .lk-gallery-card .cap{
    font-family:var(--sans);font-size:14.5px;line-height:1.6;color:var(--stein);margin:0;
  }
  .lk-gallery-empty{
    font-family:var(--sans);font-size:16px;color:var(--stein);font-style:italic;
    padding:24px 0;
  }

  /* Lightbox */
  .lk-lightbox[hidden]{display:none !important;}
  .lk-lightbox{
    position:fixed;inset:0;z-index:1000;
    background:rgba(11,42,43,0.92);
    display:flex;align-items:center;justify-content:center;
    padding:48px 24px;
    animation:lkLightboxIn .18s ease-out;
  }
  @keyframes lkLightboxIn{from{opacity:0;}to{opacity:1;}}
  @media (prefers-reduced-motion: reduce){
    .lk-lightbox{animation:none;}
  }
  .lk-lightbox figure{
    margin:0;max-width:1100px;width:100%;
    display:flex;flex-direction:column;align-items:center;gap:16px;
  }
  .lk-lightbox-image{
    max-width:100%;max-height:70vh;width:auto;height:auto;
    object-fit:contain;display:block;
    box-shadow:0 30px 80px -30px rgba(0,0,0,0.6);
    transition:opacity .15s ease;
  }
  .lk-lightbox figcaption{
    text-align:center;color:var(--creme);max-width:780px;
    display:flex;flex-direction:column;gap:6px;
  }
  .lk-lightbox-title{
    font-family:var(--serif);font-weight:500;font-size:22px;line-height:1.25;
    color:var(--creme);margin:0;
  }
  .lk-lightbox-title:empty{display:none;}
  .lk-lightbox-caption{
    font-family:var(--sans);font-size:15.5px;line-height:1.6;
    color:rgba(245,239,231,0.85);margin:0;
  }
  .lk-lightbox-caption:empty{display:none;}
  .lk-lightbox-close,
  .lk-lightbox-prev,
  .lk-lightbox-next{
    position:absolute;background:rgba(11,42,43,0.6);color:var(--creme);
    border:1px solid rgba(245,239,231,0.25);
    width:44px;height:44px;border-radius:50%;
    font-size:22px;line-height:1;cursor:pointer;
    display:flex;align-items:center;justify-content:center;
    transition:background .15s ease, border-color .15s ease;
  }
  .lk-lightbox-close:hover,
  .lk-lightbox-prev:hover,
  .lk-lightbox-next:hover,
  .lk-lightbox-close:focus-visible,
  .lk-lightbox-prev:focus-visible,
  .lk-lightbox-next:focus-visible{
    background:rgba(11,42,43,0.85);
    border-color:var(--gold);
    outline:none;
  }
  .lk-lightbox-close{top:16px;right:16px;}
  .lk-lightbox-prev{left:16px;top:50%;transform:translateY(-50%);}
  .lk-lightbox-next{right:16px;top:50%;transform:translateY(-50%);}
  .lk-lightbox-counter{
    position:absolute;bottom:16px;left:50%;transform:translateX(-50%);
    font-family:var(--sans);font-size:13px;letter-spacing:0.06em;
    color:rgba(245,239,231,0.75);
    background:rgba(11,42,43,0.6);
    border:1px solid rgba(245,239,231,0.2);
    padding:4px 14px;border-radius:999px;
    font-variant-numeric:tabular-nums;
    white-space:nowrap;
    max-width:calc(100vw - 130px);
    overflow:hidden;text-overflow:ellipsis;
  }
  /* Slider-Dots — nur sichtbar wenn ein Beitrag mehr als 1 Bild hat */
  .lk-lightbox-dots{
    display:flex;align-items:center;justify-content:center;gap:8px;
    margin-top:6px;
  }
  .lk-lightbox-dots[hidden]{display:none;}
  .lk-lightbox-dots .dot{
    width:8px;height:8px;border-radius:50%;
    background:rgba(245,239,231,0.35);
    border:0;cursor:pointer;padding:0;
    transition:background .15s ease, transform .15s ease;
  }
  .lk-lightbox-dots .dot[aria-current="true"]{
    background:var(--gold);transform:scale(1.3);
  }
  .lk-lightbox-dots .dot:focus-visible{
    outline:2px solid var(--gold);outline-offset:3px;
  }
  body.lk-lightbox-open{overflow:hidden;}

  @media (max-width:960px){
    .lk-intro-grid{grid-template-columns:1fr;gap:32px;}
    .lk-manifest-grid{grid-template-columns:1fr;gap:24px;}
    .lk-gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;}
    .lk-contacts-grid{grid-template-columns:1fr;gap:18px;}
    .lk-intro,.lk-manifest,.lk-contacts,.lk-gallery{padding:var(--space-section-sm) 0;}
  }
  @media (max-width:560px){
    .lk-gallery-grid{grid-template-columns:1fr;}
    .lk-lightbox{padding:24px 12px;}
    .lk-lightbox-prev,.lk-lightbox-next{width:40px;height:40px;}
    .lk-lightbox-image{max-height:62vh;}
  }
</style>

<main id="top">

<PageHero variant="feature" image={page.hero.image || undefined} imageAlt={page.hero.imageAlt || ""}>
  <Fragment slot="eyebrow">{page.hero.eyebrow}</Fragment>
  <Fragment slot="title">{page.hero.title}{page.hero.titleHighlight && <><br />{page.hero.titleHighlight}</>}</Fragment>
  <Fragment slot="lede">{page.hero.lede}</Fragment>
</PageHero>

<section class="lk-manifest" aria-label="Kunst an der UNESCO-Schule">
  <div class="container">
    <div class="lk-manifest-grid">
      <div>
        <span class="eyebrow">Unser Selbstverständnis</span>
        <h2>Kunst an der UNESCO-Schule</h2>
      </div>
      <div class="body">
        <p>Kunst beginnt dort, wo Worte nicht mehr ausreichen.</p>
        <p>Bei uns ist Kunst ein Raum für Ideen, für Ausdruck, für neue Blickwinkel und für den eigenen Weg. Denn genau den gilt es zu finden.</p>
        <p>Mit vielfältigen Techniken und Zugängen begleiten wir unsere Schülerinnen und Schüler dabei, ihre eigene künstlerische Stimme zu entdecken.</p>
        <blockquote>
          „Jeder Mensch ist ein Künstler."
          <cite>Joseph Beuys</cite>
        </blockquote>
        <p>Im Unterricht wird ausprobiert, verworfen, neu gedacht: mit Stift, Farbe, Kamera, analogem oder digitalem Werkzeug.</p>
        <p>Selbst in der Sekundarstufe II, wo zentrale Themen vorgegeben sind, bleibt Raum für Individualität.</p>
        <p>Kreative Praxis verbindet sich dabei mit Einblicken in Kunstgeschichte und zeitgenössische Positionen. Museumsbesuche sind für uns kein Extra, sondern selbstverständlicher Teil kultureller Bildung.</p>
        <p>Kunst soll sichtbar sein. Deshalb verlassen unsere Arbeiten den Klassenraum. Sie begegnen uns im Schulgebäude und im öffentlichen Raum, beispielsweise auf Ausstellungen.</p>
        <p>Kunst spricht eine Sprache, die verbindet. Sie zeigt, was uns bewegt und macht Gedanken sichtbar.</p>
        <p>Und genau das macht Kunst bei uns so lebendig.</p>
        <p>Einen Einblick in diese Vielfalt geben unsere Galerien der verschiedenen Jahrgangsstufen.</p>
      </div>
    </div>
  </div>
</section>

{(lange || wolle) && (
  <section class="lk-contacts" aria-label="Ansprechpartnerinnen Kunst">
    <div class="container">
      <div class="head">
        <span class="eyebrow">Ansprechpartnerinnen</span>
        <h2>Wer das Fach Kunst bei uns trägt</h2>
      </div>
      <div class="lk-contacts-grid">
        {lange && (
          <ContactCard
            teacher={lange}
            roleLabel="Fachschaft Kunst"
            ctaLabel="E-Mail an Frau Lange"
          />
        )}
        {wolle && (
          <ContactCard
            teacher={wolle}
            roleLabel="Fachschaft Kunst"
            ctaLabel="E-Mail an Frau Wolle"
          />
        )}
      </div>
    </div>
  </section>
)}

<section class="lk-gallery" aria-label="Galerie Lebendige Kunst">
  <div class="container">
    <div class="head">
      {page.gallery?.eyebrow && <span class="eyebrow">{page.gallery.eyebrow}</span>}
      <h2>{page.gallery?.title}</h2>
      {page.gallery?.body && <p>{page.gallery.body}</p>}
    </div>

    {galleryItems.length > 0 ? (
      <ul class="lk-gallery-grid" role="list">
        {galleryItems.map((item, i) => {
          const cover = item.images[0];
          const count = item.images.length;
          const aria = count > 1
            ? `${item.title || cover.imageAlt} — ${count} Bilder ansehen`
            : `Bild öffnen: ${item.title || cover.imageAlt}`;
          return (
            <li>
              <button type="button" class="lk-gallery-card" data-lightbox-index={firstImageIndices[i]} aria-label={aria}>
                <div class="media">
                  <img src={cover.image} alt={cover.imageAlt} loading="lazy" decoding="async" width="800" height="600" />
                  {count > 1 && (
                    <span class="multi-badge" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="14" height="14" rx="1"/>
                        <path d="M7 7h14v14"/>
                      </svg>
                      {count} Bilder
                    </span>
                  )}
                </div>
                {(item.title || item.caption) && (
                  <div class="body">
                    {item.title && <h3>{item.title}</h3>}
                    {item.caption && <p class="cap">{item.caption}</p>}
                  </div>
                )}
              </button>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="lk-gallery-empty">Bald gibt es hier erste Bilder zu sehen.</p>
    )}
  </div>

  {flatImages.length > 0 && (
    <>
      <div class="lk-lightbox" role="dialog" aria-modal="true" aria-label="Galerie-Bild" hidden>
        <button type="button" class="lk-lightbox-close" aria-label="Schließen">×</button>
        <button type="button" class="lk-lightbox-prev"  aria-label="Vorheriges Bild">‹</button>
        <button type="button" class="lk-lightbox-next"  aria-label="Nächstes Bild">›</button>
        <figure>
          <img class="lk-lightbox-image" alt="" />
          <figcaption>
            <h3 class="lk-lightbox-title"></h3>
            <p class="lk-lightbox-caption"></p>
            <div class="lk-lightbox-dots" role="tablist" aria-label="Bilder dieses Beitrags" hidden></div>
          </figcaption>
        </figure>
        <span class="lk-lightbox-counter" aria-live="polite"></span>
      </div>

      <script type="application/json" id="lk-gallery-data" set:html={safeInlineJson(flatImages)}></script>

      <script is:inline>
        (function(){
          const dataEl = document.getElementById("lk-gallery-data");
          if (!dataEl) return;
          let items;
          try { items = JSON.parse(dataEl.textContent || "[]"); }
          catch (e) { return; }
          if (!Array.isArray(items) || items.length === 0) return;

          const lightbox = document.querySelector(".lk-lightbox");
          if (!lightbox) return;
          const imgEl   = lightbox.querySelector(".lk-lightbox-image");
          const titleEl = lightbox.querySelector(".lk-lightbox-title");
          const capEl   = lightbox.querySelector(".lk-lightbox-caption");
          const dotsEl  = lightbox.querySelector(".lk-lightbox-dots");
          const counter = lightbox.querySelector(".lk-lightbox-counter");
          const closeBtn= lightbox.querySelector(".lk-lightbox-close");
          const prevBtn = lightbox.querySelector(".lk-lightbox-prev");
          const nextBtn = lightbox.querySelector(".lk-lightbox-next");

          let currentIndex = 0;
          let lastFocused  = null;

          // Index des ersten Bildes des Beitrags, zu dem `flatIdx` gehört.
          function itemStart(flatIdx){
            const cur = items[flatIdx];
            return flatIdx - (cur.posInItem - 1);
          }

          function renderDots(flatIdx){
            const item = items[flatIdx];
            if (!item || item.totalInItem <= 1) {
              dotsEl.hidden = true;
              dotsEl.innerHTML = "";
              return;
            }
            dotsEl.hidden = false;
            const start = itemStart(flatIdx);
            // Nur neu rendern, wenn sich der Beitrag oder die Anzahl ändert.
            if (parseInt(dotsEl.dataset.start || "-1", 10) !== start) {
              dotsEl.innerHTML = "";
              for (let i = 0; i < item.totalInItem; i++) {
                const target = start + i;
                const dot = document.createElement("button");
                dot.type = "button";
                dot.className = "dot";
                dot.setAttribute("role", "tab");
                dot.setAttribute("aria-label", "Bild " + (i + 1) + " von " + item.totalInItem);
                dot.addEventListener("click", function(){ render(target); });
                dotsEl.appendChild(dot);
              }
              dotsEl.dataset.start = String(start);
            }
            dotsEl.querySelectorAll(".dot").forEach(function(d, i){
              if (start + i === flatIdx) d.setAttribute("aria-current", "true");
              else d.removeAttribute("aria-current");
            });
          }

          function render(index){
            const item = items[index];
            if (!item) return;
            imgEl.src = item.image;
            imgEl.alt = item.imageAlt || "";
            titleEl.textContent = item.title || "";
            capEl.textContent = item.caption || "";
            // Counter zeigt Position im Beitrag, wenn er mehrere Bilder hat,
            // sonst die globale Position.
            if (item.totalInItem > 1) {
              counter.textContent = "Bild " + item.posInItem + " von " + item.totalInItem;
            } else {
              counter.textContent = (index + 1) + " / " + items.length;
            }
            renderDots(index);
            currentIndex = index;
          }

          function open(index){
            lastFocused = document.activeElement;
            render(index);
            lightbox.hidden = false;
            document.body.classList.add("lk-lightbox-open");
            closeBtn.focus();
          }

          function close(){
            lightbox.hidden = true;
            document.body.classList.remove("lk-lightbox-open");
            if (lastFocused && typeof lastFocused.focus === "function") {
              lastFocused.focus();
            }
          }

          function next(){ render((currentIndex + 1) % items.length); }
          function prev(){ render((currentIndex - 1 + items.length) % items.length); }

          document.querySelectorAll(".lk-gallery-card").forEach(function(card){
            card.addEventListener("click", function(){
              const idx = parseInt(card.getAttribute("data-lightbox-index") || "0", 10);
              open(idx);
            });
          });

          closeBtn.addEventListener("click", close);
          nextBtn.addEventListener("click", next);
          prevBtn.addEventListener("click", prev);

          lightbox.addEventListener("click", function(e){
            if (e.target === lightbox) close();
          });

          document.addEventListener("keydown", function(e){
            if (lightbox.hidden) return;
            if (e.key === "Escape") { e.preventDefault(); close(); }
            else if (e.key === "ArrowRight") { e.preventDefault(); next(); }
            else if (e.key === "ArrowLeft")  { e.preventDefault(); prev(); }
            else if (e.key === "Tab") {
              const focusables = [closeBtn, prevBtn, nextBtn].concat(
                Array.from(dotsEl.querySelectorAll(".dot"))
              );
              const idx = focusables.indexOf(document.activeElement);
              e.preventDefault();
              if (e.shiftKey) {
                focusables[(idx - 1 + focusables.length) % focusables.length].focus();
              } else {
                focusables[(idx + 1) % focusables.length].focus();
              }
            }
          });
        })();
      </script>
    </>
  )}
</section>

</main>
</BaseLayout>
