---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import MailLink from "../components/MailLink.astro";
import { getSingle } from "../lib/pageContent";
import { safeBreaks } from "../lib/safeMarkup";

// Editierbare Inhalte aus src/content/pages/leitbild.yml (Sveltia)
const lb = await getSingle("pageLeitbild");
// Schulprogramm-Inhalte (gemerged in Leitbild) aus src/content/pages/schulprogramm.yml
const sp: any = await getSingle("pageSchulprogramm");
---
<BaseLayout title="Unser Leitbild · UNESCO-Schule Essen" description="Das Leitbild der UNESCO-Schule Essen: Werte, Haltungen, Selbstverpflichtung und acht Leitsätze als gemeinsames Verständnis von Bildung.">
<style is:global>
  /* ---------- Leitbild page ---------- */
  .lb-motto{
    background:var(--petrol);color:var(--creme);
    padding:var(--space-section) 0;
  }
  .lb-motto .container{text-align:center;max-width:880px;}
  .lb-motto blockquote{
    margin:0;
    font-family:var(--serif);font-weight:500;font-style:italic;
    font-size:clamp(28px,3.4vw,46px);line-height:1.2;letter-spacing:-0.015em;
    color:var(--creme);
  }
  .lb-motto blockquote::before{
    content:"\201E";display:block;
    font-family:var(--serif);font-size:84px;line-height:0.9;
    color:var(--gold);opacity:0.7;margin-bottom:28px;
  }
  .lb-motto .sub{
    font-family:var(--sans);font-size:17px;line-height:1.65;
    color:rgba(245,239,231,0.85);
    max-width:660px;margin:32px auto 0;
  }

  /* Three values */
  .lb-values{
    background:var(--offwhite);
    padding:var(--space-section) 0 var(--space-section-sm);
  }
  .lb-values .head{max-width:760px;margin:0 0 56px;}
  .lb-values .head .eyebrow{display:block;margin-bottom:14px;}
  .lb-values .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.2vw,44px);line-height:1.15;letter-spacing:-0.015em;
    color:var(--petrol);margin:0;
  }
  .values-grid{
    display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;
  }
  .value-card{
    background:#fff;border:1px solid var(--hairline);
    border-top:var(--card-accent-width) solid var(--petrol);
    padding:var(--card-padding);
    display:flex;flex-direction:column;gap:16px;
    transition:transform var(--transition), box-shadow var(--transition);
  }
  .value-card:hover{transform:translateY(-2px);box-shadow:0 14px 36px -22px rgba(14,77,79,0.3);}
  @media (prefers-reduced-motion: reduce){.value-card:hover{transform:none;}}
  .value-card .num{
    font-family:var(--serif);font-weight:500;font-size:28px;line-height:1;
    color:var(--petrol);letter-spacing:-0.02em;
  }
  .value-card h3{
    font-family:var(--serif);font-weight:500;font-size:24px;line-height:1.2;
    color:var(--petrol);letter-spacing:-0.01em;margin:0;
  }
  .value-card p{
    font-family:var(--sans);font-size:15.5px;line-height:1.65;color:var(--tinte);margin:0;
  }

  /* ---------- Pledge (Selbstverpflichtung des Kollegiums) ---------- */
  .sp-pledge{
    background:var(--petrol);color:var(--creme);
    padding:var(--space-section) 0;position:relative;overflow:hidden;
  }
  .sp-pledge .eyebrow{
    color:rgba(245,239,231,0.6);display:block;margin-bottom:16px;
  }
  .sp-pledge h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.2vw,44px);line-height:1.12;
    color:var(--creme);margin:0 0 36px;max-width:780px;letter-spacing:-0.012em;
  }
  .sp-pledge .intro{
    font-family:var(--sans);font-size:17px;line-height:1.65;
    color:rgba(245,239,231,0.9);max-width:760px;margin:0 0 40px;
  }
  .pledge-list{
    list-style:none;margin:0;padding:0;
    display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
    gap:1px;
    background:rgba(245,239,231,0.15);
    border:1px solid rgba(245,239,231,0.15);
  }
  .pledge-list li{
    background:var(--petrol);
    padding:26px 28px;
    display:flex;gap:18px;align-items:flex-start;
  }
  .pledge-list .num{
    font-family:var(--serif);font-weight:500;font-size:32px;line-height:1;
    color:var(--gold);flex-shrink:0;letter-spacing:-0.02em;
  }
  .pledge-list .text{
    font-family:var(--sans);font-size:15px;line-height:1.55;
    color:rgba(245,239,231,0.95);
  }
  .pledge-outro{
    font-family:var(--sans);font-size:15px;line-height:1.7;color:rgba(245,239,231,0.8);
    max-width:780px;margin:40px 0 0;font-style:italic;
  }

  /* ---------- Leitsätze Intro ---------- */
  .sp-pillars-intro{
    background:var(--offwhite);
    padding:var(--space-section) 0 48px;
  }
  .sp-pillars-intro .eyebrow{display:block;margin-bottom:16px;}
  .sp-pillars-intro h2{
    font-family:var(--serif);font-weight:500;font-size:clamp(30px,3.2vw,42px);
    line-height:1.12;color:var(--petrol);margin:0 0 20px;letter-spacing:-0.012em;
    max-width:760px;
  }
  .sp-pillars-intro p{
    font-family:var(--sans);font-size:16.5px;line-height:1.7;color:var(--stein);
    max-width:72ch;margin:0 0 14px;
  }
  .sp-pillars-intro .two-cols{
    display:grid;grid-template-columns:1fr 1fr;gap:48px;margin-top:32px;
  }
  .sp-pillars-intro .two-cols .card{
    padding:var(--card-padding);background:#fff;border:1px solid var(--hairline);
    border-top:var(--card-accent-width) solid var(--petrol);
    border-radius:var(--card-radius);
  }
  .sp-pillars-intro .two-cols h3{
    font-family:var(--serif);font-weight:500;font-size:22px;color:var(--petrol);
    margin:0 0 10px;letter-spacing:-0.01em;
  }
  .sp-pillars-intro .two-cols p{font-size:15px;margin:0;}

  /* ---------- 8 Leitsätze ---------- */
  .sp-leitsaetze{
    background:var(--offwhite);
    padding:24px 0 var(--space-section-lg);
  }
  .leitsatz{
    display:grid;
    grid-template-columns:minmax(0,5fr) minmax(0,7fr);
    gap:56px;
    padding:56px 0;
    border-top:1px solid var(--hairline);
    align-items:start;
  }
  .leitsatz:last-child{border-bottom:1px solid var(--hairline);}
  .leitsatz.flip{grid-template-columns:minmax(0,7fr) minmax(0,5fr);}
  .leitsatz.flip .media{order:2;}
  .leitsatz .media{
    aspect-ratio:5/4;overflow:hidden;background:var(--creme);
    border-radius:2px;position:relative;
  }
  .leitsatz .media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease;}
  .leitsatz:hover .media img{transform:scale(1.02);}
  /* Platzhalter-Verläufe (Foto folgt) — im Farbschema der Seite */
  .leitsatz .media-ph{display:flex;align-items:center;justify-content:center;}
  .media-ph-0{background:linear-gradient(135deg, var(--petrol) 0%, var(--petrol-dark) 100%);}
  .media-ph-1{background:linear-gradient(135deg, var(--bordeaux) 0%, var(--petrol) 100%);}
  .media-ph-2{background:linear-gradient(135deg, var(--gold) 0%, var(--bordeaux) 100%);}
  .media-ph-3{background:linear-gradient(135deg, var(--petrol) 0%, var(--gold) 100%);}
  .media-ph-4{background:linear-gradient(135deg, var(--petrol-dark) 0%, var(--bordeaux) 100%);}
  .media-ph-5{background:linear-gradient(135deg, var(--gold-hover) 0%, var(--petrol) 100%);}
  .media-ph-6{background:linear-gradient(135deg, var(--bordeaux) 0%, var(--petrol-dark) 100%);}
  .leitsatz .media-ph .ph-note{
    font-family:var(--sans);font-size:12.5px;font-weight:500;
    letter-spacing:0.14em;text-transform:uppercase;
    color:rgba(245,239,231,0.78);
    padding:7px 16px;border:1px solid rgba(245,239,231,0.4);border-radius:999px;
    backdrop-filter:blur(2px);
  }
  .leitsatz .media .num-badge{
    position:absolute;top:16px;left:16px;
    width:48px;height:48px;border-radius:50%;
    background:var(--creme);color:var(--petrol);
    display:flex;align-items:center;justify-content:center;
    font-family:var(--serif);font-weight:500;font-size:22px;
    letter-spacing:-0.02em;
    box-shadow:0 4px 12px -4px rgba(0,0,0,0.2);
  }
  .leitsatz h3{
    font-family:var(--serif);font-weight:500;font-size:clamp(26px,2.6vw,36px);
    line-height:1.15;color:var(--petrol);letter-spacing:-0.012em;
    margin:0 0 20px;
  }
  .leitsatz .claim{
    font-family:var(--sans);font-size:16.5px;line-height:1.65;
    color:var(--tinte);margin:0 0 24px;max-width:60ch;
  }
  .leitsatz ul{
    list-style:none;margin:0 0 24px;padding:0;
  }
  .leitsatz ul li{
    position:relative;padding:8px 0 8px 22px;
    font-family:var(--sans);font-size:15px;line-height:1.55;color:var(--stein);
    border-bottom:1px solid var(--hairline);
  }
  .leitsatz ul li:first-child{border-top:1px solid var(--hairline);}
  .leitsatz ul li::before{
    content:"";position:absolute;left:0;top:16px;
    width:10px;height:1px;background:var(--bordeaux);
  }
  .leitsatz .future{
    margin-top:18px;padding:16px 18px;
    background:rgba(212,165,116,0.14);
    border-left:3px solid var(--gold);
  }
  .leitsatz .future h4{
    font-family:var(--sans);font-weight:600;font-size:11px;
    letter-spacing:0.14em;text-transform:uppercase;color:var(--gold-deep);
    margin:0 0 8px;
  }
  .leitsatz .future ul{margin:0;}
  .leitsatz .future li{
    border:0;padding:4px 0 4px 18px;font-size:14px;color:var(--tinte);
  }
  .leitsatz .future li::before{
    top:13px;background:var(--gold);
  }

  /* Timeline / path */
  .lb-path{
    background:var(--creme);
    padding:var(--space-section) 0;position:relative;overflow:hidden;
  }
  .lb-path::before{
    content:"";position:absolute;inset:0;
    background-image:
      radial-gradient(circle at 20% 20%, rgba(14,77,79,0.035) 1px, transparent 1px),
      radial-gradient(circle at 80% 80%, rgba(110,38,57,0.025) 1px, transparent 1px);
    background-size:28px 28px, 36px 36px;opacity:0.6;pointer-events:none;
  }
  .lb-path .container{position:relative;}
  .lb-path .head{max-width:760px;margin:0 0 56px;}
  .lb-path .head .eyebrow{display:block;margin-bottom:14px;}
  .lb-path .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.2vw,44px);line-height:1.15;letter-spacing:-0.015em;
    color:var(--petrol);margin:0 0 16px;
  }
  .lb-path .head p{
    font-family:var(--sans);font-size:16.5px;line-height:1.65;color:var(--stein);
    max-width:640px;margin:0;
  }
  .stages{
    display:grid;grid-template-columns:repeat(3,minmax(0,1fr));
    gap:0;
    border:1px solid var(--hairline);
    background:#fff;
  }
  .stage{
    padding:36px 32px 40px;
    border-right:1px solid var(--hairline);
    display:flex;flex-direction:column;gap:12px;
    position:relative;
  }
  .stage:last-child{border-right:0;}
  .stage .klassen{
    font-family:var(--sans);font-size:11.5px;font-weight:600;
    letter-spacing:0.14em;text-transform:uppercase;color:var(--petrol);
  }
  .stage h3{
    font-family:var(--serif);font-weight:500;font-size:26px;line-height:1.15;
    color:var(--petrol);letter-spacing:-0.01em;margin:0 0 6px;
  }
  .stage p{
    font-family:var(--sans);font-size:15.5px;line-height:1.65;color:var(--tinte);margin:0;
  }
  .stage .num-big{
    position:absolute;top:24px;right:28px;
    font-family:var(--serif);font-weight:500;font-size:64px;line-height:1;
    color:rgba(14,77,79,0.08);letter-spacing:-0.04em;pointer-events:none;
  }

  /* CTA */
  .lb-cta{
    background:var(--offwhite);
    padding:var(--space-section) 0;
    border-top:1px solid var(--hairline);
  }
  .lb-cta-grid{
    display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:56px;align-items:center;
  }
  .lb-cta h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(28px,3vw,40px);line-height:1.15;
    color:var(--petrol);letter-spacing:-0.015em;margin:0;
  }
  .lb-cta p{
    font-family:var(--sans);font-size:17px;line-height:1.6;color:var(--stein);
    margin:0 0 24px;max-width:62ch;
  }
  .lb-cta-links{display:flex;gap:14px;flex-wrap:wrap;}

  @media (max-width:960px){
    .values-grid{grid-template-columns:1fr;gap:20px;}
    .pledge-list{grid-template-columns:1fr;}
    .sp-pillars-intro .two-cols{grid-template-columns:1fr;gap:24px;}
    .leitsatz, .leitsatz.flip{grid-template-columns:1fr;gap:24px;}
    .leitsatz.flip .media{order:-1;}
    .leitsatz .media{order:-1;aspect-ratio:16/10;}
    .stages{grid-template-columns:1fr;}
    .stage{border-right:0;border-bottom:1px solid var(--hairline);}
    .stage:last-child{border-bottom:0;}
    .lb-cta-grid{grid-template-columns:1fr;gap:24px;}
    .lb-motto{padding:64px 0;}
    .lb-values,.lb-path,.lb-cta,.sp-pledge,.sp-pillars-intro{padding:64px 0;}
  }
  @media (max-width:640px){
    .sp-leitsaetze{padding:12px 0 72px;}
    .leitsatz{padding:36px 0;}
  }
</style>

<main id="top">

<PageHero variant="feature" image="assets/schulhof-hero.jpg" imageAlt="Gesamtes Kollegium und die Schülerschaft der UNESCO-Schule Essen auf dem Schulhof">
  {lb.hero.badge && <Fragment slot="badge">{lb.hero.badge}</Fragment>}
  <Fragment slot="eyebrow">{lb.hero.eyebrow}</Fragment>
  <Fragment slot="title">{lb.hero.title}{lb.hero.titleHighlight && <><br /><em>{lb.hero.titleHighlight}</em></>}</Fragment>
  <Fragment slot="lede">{lb.hero.lede}</Fragment>
</PageHero>

<section class="lb-motto" aria-label="Unser Motto">
  <div class="container">
    <blockquote set:html={safeBreaks(lb.motto.quote)} />
    <p class="sub">{lb.motto.sub}</p>
  </div>
</section>

<section class="lb-values" aria-label="Unsere Werte">
  <div class="container">
    <div class="head">
      {lb.values.eyebrow && <span class="eyebrow">{lb.values.eyebrow}</span>}
      <h2>{lb.values.title}</h2>
    </div>
    <div class="values-grid">
      {lb.values.cards.map((card) => (
        <article class="value-card">
          <div class="num">{card.num}</div>
          <h3>{card.title}</h3>
          <p>{card.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>


<section class="sp-pledge" aria-label="Selbstverpflichtung des Kollegiums">
  <div class="container">
    <span class="eyebrow">{sp.pledge.eyebrow}</span>
    <h2>{sp.pledge.title}</h2>
    <p class="intro">{sp.pledge.intro}</p>
    <ol class="pledge-list">
      {sp.pledge.list.map((item: any) => (
        <li><span class="num">{item.num}</span><span class="text">{item.text}</span></li>
      ))}
    </ol>
    <p class="pledge-outro">{sp.pledge.outro}</p>
  </div>
</section>


<section class="sp-pillars-intro">
  <div class="container">
    {sp.pillarsIntro.eyebrow && <span class="eyebrow">{sp.pillarsIntro.eyebrow}</span>}
    {sp.pillarsIntro.title && <h2>{sp.pillarsIntro.title}</h2>}
    <p>{sp.pillarsIntro.body}</p>
    <div class="two-cols">
      {sp.pillarsIntro.pillars.map((p: any) => (
        <div class="card">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>


<section class="sp-leitsaetze">
  <div class="container">
    {sp.leitsaetze.map((l: any, idx: number) => (
      <article class={`leitsatz${idx % 2 === 1 ? " flip" : ""}`}>
        <div class={`media media-ph media-ph-${idx % 7}`} role="img" aria-label="Platzhalter — Foto folgt">
          <span class="ph-note">Foto folgt</span>
          <span class="num-badge">{l.num}</span>
        </div>
        <div class="body">
          <h3>{l.title}</h3>
          <p class="claim">{l.claim}</p>
          {l.points && l.points.length > 0 && (
            <ul>
              {l.points.map((pt: string) => <li>{pt}</li>)}
            </ul>
          )}
          {l.futureGoals && l.futureGoals.length > 0 && (
            <div class="future">
              <h4>Schulentwicklungsziele</h4>
              <ul>
                {l.futureGoals.map((g: string) => <li>{g}</li>)}
              </ul>
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>


<section class="lb-cta" aria-label="Einladung">
  <div class="container">
    <div class="lb-cta-grid">
      <div>
        <h2>Am besten: vor Ort erleben</h2>
      </div>
      <div>
        <p>Das Leitbild lebt im Alltag: in den Fluren, in den Pausen, im Unterricht. Kommen Sie zum Tag der offenen Tür, oder vereinbaren Sie ein Gespräch. Wir zeigen Ihnen gerne, wie „Gemeinsam lernen" bei uns konkret aussieht.</p>
        <div class="lb-cta-links">
          <a href="Tag-der-offenen-Tuer.html" class="btn btn-primary">Tag der offenen Tür <span class="arrow">→</span></a>
          <MailLink email="info@unesco-schule-essen.de" class="btn btn-secondary" label="Gespräch vereinbaren">Gespräch vereinbaren <span class="arrow">→</span></MailLink>
        </div>
      </div>
    </div>
  </div>
</section>

</main>
</BaseLayout>
