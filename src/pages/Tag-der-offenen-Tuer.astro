---
import BaseLayout from "../layouts/BaseLayout.astro";
import OpenDayHero from "../components/OpenDayHero.astro";

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (p: string) => p.startsWith("/") || /^https?:\/\//.test(p) ? p : `${BASE}/${p}`;

// Stand der Planung: Oktober 2026. Nur bestätigte Angebote, keine Namen, keine Räume.
const parentOffers = [
  { title: "Führungen durch das Haus", text: "Start am Info-Point im Haupteingang" },
  { title: "Eltern- und Schülercafé", text: "Kaffee, Kuchen, Waffeln und Gespräche" },
];

const kidsOffers = [
  { tone: "violet", title: "Instrumente kennenlernen", text: "Mit Musikerinnen und Musikern selbst ausprobieren" },
  { tone: "green",  title: "Mikroskopieren", text: "Im neuen Biologieraum" },
  { tone: "blue",   title: "Experimente", text: "Forschen wie im Profil Forscher²" },
  { tone: "orange", title: "Theater", text: "Szenen aus dem Profil WortArt⁺" },
  { tone: "violet", title: "Kunst", text: "Verrückte Porträts als Button" },
];

const upperOffers = [
  "Informationen zur Oberstufe und zur Aufnahme in die EF",
  "Persönliche Beratung durch das Oberstufenteam",
  "Rundgang mit Schülerinnen und Schülern der Oberstufe",
  "Fächer und Leistungskurse kennenlernen",
  "Abitur oder Fachhochschulreife: welcher Weg passt zu dir?",
  "Austausch mit Schülerinnen, Schülern und Eltern",
];

const posters = {
  grundschule: { img: "assets/tdot/plakat-grundschule.jpg", label: "Plakat „Tag der offenen Tür 2026“ für Klasse 4 und Eltern vergrößern", alt: "Plakat: UNESCO-Gymnasium, Tag der offenen Tür 2026, Samstag, 5. Dezember, 10 bis 14 Uhr, für Kinder der 4. Klassen und ihre Eltern. Rund um ein Foto des Schuleingangs stehen die Angebote: Instrumente kennenlernen, Mikroskopieren, Experimente, Theater, Programmieren, Mathe-Magie, Kunst, Schulsong, Elterncafé." },
  abi: { img: "assets/tdot/plakat-von-hier-zum-abi.jpg", label: "Plakat „Von hier zum Abi“ vergrößern", alt: "Plakat: Von hier zum Abi. Am 5.12. für dich: Beratung durch das Oberstufenteam, Rundgang mit unseren Schüler:innen, Fächer und Leistungskurse kennenlernen, Programm in der Aula, Café. Gemeinsamer Neustart in der EF, persönliche Beratung, Abitur oder Fachhochschulreife." },
  oberstufe: { img: "assets/tdot/plakat-einladung-oberstufe.jpg", label: "Plakat „Einladung zur Oberstufe“ vergrößern", alt: "Plakat: Einladung zum Tag der offenen Tür, Informationen zur gymnasialen Oberstufe. Wo, wer, was und wann auf einen Blick." },
};
---
<BaseLayout
  title="Tag der offenen Tür am 5. Dezember 2026 · UNESCO-Schule Essen"
  description="Tag der offenen Tür an der UNESCO-Schule Essen: Samstag, 5. Dezember 2026, 10 bis 14 Uhr, ohne Anmeldung. Lehrkräfte der neuen 5 kennenlernen, Beratung zur Erprobungsstufe und Informationen zum Neustart in der Oberstufe (EF)."
  ogImage="assets/tdot/plakat-grundschule.jpg"
  openDayBar={false}
>
<style is:global>
  /* ---------- Tag der offenen Tür 2026 ---------- */

  /* Zielgruppen-Kacheln */
  .tdo-who{background:var(--offwhite);padding:calc(var(--space-section) * 0.6) 0;}
  .tdo-who-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;}
  .tdo-who-card{
    display:grid;grid-template-columns:minmax(0,1fr) 140px;gap:24px;align-items:center;
    background:#fff;border:1px solid var(--hairline);
    border-top:var(--card-accent-width) solid var(--petrol);
    padding:28px;text-decoration:none;color:inherit;
    transition:transform var(--transition), box-shadow var(--transition);
  }
  .tdo-who-card.upper{border-top-color:#1F5FA8;}
  .tdo-who-card:hover,.tdo-who-card:focus-visible{
    transform:translateY(var(--card-hover-lift));
    box-shadow:0 16px 40px -22px rgba(14,77,79,0.3);outline:none;
  }
  .tdo-who-card:focus-visible{outline:2px solid var(--petrol);outline-offset:3px;}
  @media (prefers-reduced-motion: reduce){ .tdo-who-card:hover,.tdo-who-card:focus-visible{transform:none;} }
  .tdo-who-card .kicker{
    font-family:var(--sans);font-size:11.5px;font-weight:600;letter-spacing:0.14em;
    text-transform:uppercase;color:var(--bordeaux);display:block;margin-bottom:10px;
  }
  .tdo-who-card h2{
    font-family:var(--serif);font-weight:500;font-size:24px;line-height:1.2;
    color:var(--petrol);margin:0 0 10px;letter-spacing:-0.01em;
  }
  .tdo-who-card p{font-family:var(--sans);font-size:15px;line-height:1.6;color:var(--tinte);margin:0 0 14px;}
  .tdo-who-card .go{font-family:var(--sans);font-size:15px;font-weight:600;color:var(--petrol);}
  .tdo-who-card img{width:100%;height:auto;display:block;box-shadow:0 10px 24px -14px rgba(0,0,0,0.45);transform:rotate(2deg);}

  /* Gemeinsam */
  .tdo-h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.4vw,46px);line-height:1.12;letter-spacing:-0.015em;
    color:var(--petrol);margin:0 0 18px;
  }
  .tdo-lead{font-family:var(--sans);font-size:17px;line-height:1.65;color:var(--stein);margin:0;}
  .tdo-split{display:grid;grid-template-columns:minmax(0,8fr) minmax(0,4fr);gap:56px;align-items:start;}
  .tdo-section-kicker{
    display:block;margin-bottom:14px;
    font-family:var(--sans);font-size:12px;font-weight:600;letter-spacing:0.14em;
    text-transform:uppercase;color:var(--bordeaux);
  }
  .tdo-subhead{
    font-family:var(--sans);font-size:13px;font-weight:600;letter-spacing:0.12em;
    text-transform:uppercase;color:var(--petrol);margin:40px 0 16px;
  }

  /* Plakate: Klick lädt das PDF, beim Darüberfahren leicht größer */
  .tdo-poster-link{
    display:block;width:100%;padding:0;border:0;background:none;cursor:zoom-in;
    transition:transform .25s ease, box-shadow .25s ease;
  }
  .tdo-poster-link img{width:100%;height:auto;display:block;box-shadow:0 24px 50px -24px rgba(0,0,0,0.45);}
  .tdo-poster-link:hover,.tdo-poster-link:focus-visible{transform:scale(1.025);}
  .tdo-poster-link:focus-visible{outline:2px solid var(--bordeaux);outline-offset:4px;}
  @media (prefers-reduced-motion: reduce){ .tdo-poster-link:hover,.tdo-poster-link:focus-visible{transform:none;} }

  /* Klasse 4 und Eltern */
  .tdo-kids{background:var(--offwhite);padding:calc(var(--space-section) * 0.4) 0 var(--space-section);scroll-margin-top:110px;}
  .tdo-parents{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--hairline);border:1px solid var(--hairline);}
  .tdo-parents li{background:#fff;padding:22px 24px;display:flex;flex-direction:column;gap:6px;}
  .tdo-parents h4{font-family:var(--serif);font-weight:500;font-size:20px;line-height:1.25;color:var(--petrol);margin:0;}
  .tdo-parents p{font-family:var(--sans);font-size:15px;line-height:1.55;color:var(--tinte);margin:0;}
  .tdo-offers{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;}
  .tdo-offer{
    background:#fff;border:1px solid var(--hairline);padding:16px 20px 16px 22px;
    border-left:5px solid var(--tone);display:flex;flex-direction:column;gap:4px;
  }
  .tdo-offer:last-child:nth-child(odd){grid-column:1 / -1;}
  .tdo-offer h4{font-family:var(--sans);font-size:17px;font-weight:700;line-height:1.3;color:var(--tinte);margin:0;}
  .tdo-offer p{font-family:var(--sans);font-size:14.5px;line-height:1.55;color:var(--stein);margin:0;}
  .tone-violet{--tone:#5B3FA6;}
  .tone-green{--tone:#3E9B3A;}
  .tone-blue{--tone:#2A86B5;}
  .tone-orange{--tone:#E2572B;}
  .tdo-note{
    margin-top:24px;padding:16px 20px;background:rgba(212,165,116,0.14);border-left:3px solid var(--gold);
    font-family:var(--sans);font-size:15px;line-height:1.6;color:var(--tinte);
  }
  .tdo-note a{color:var(--bordeaux);font-weight:600;}
  .tdo-poster{position:sticky;top:120px;}

  /* Lightbox für die Plakate */
  .tdo-lightbox{
    border:0;padding:0;background:transparent;overflow:visible;
    max-width:min(92vw, 820px);max-height:94vh;
  }
  .tdo-lightbox::backdrop{background:rgba(11,42,43,0.88);}
  .tdo-lightbox img{
    display:block;max-width:100%;max-height:90vh;width:auto;height:auto;margin:0 auto;
    box-shadow:0 30px 80px -30px rgba(0,0,0,0.7);
  }
  .tdo-lightbox[open] img{animation:tdoGrow .28s cubic-bezier(0.2,0.8,0.2,1);}
  .tdo-lightbox[open]::backdrop{animation:tdoFade .2s ease-out;}
  @keyframes tdoGrow{from{transform:scale(0.82);opacity:0;}to{transform:none;opacity:1;}}
  @keyframes tdoFade{from{opacity:0;}to{opacity:1;}}
  @media (prefers-reduced-motion: reduce){
    .tdo-lightbox[open] img,.tdo-lightbox[open]::backdrop{animation:none;}
  }
  .tdo-lightbox-close{
    position:fixed;top:16px;right:16px;
    width:44px;height:44px;border-radius:50%;
    background:rgba(11,42,43,0.7);color:var(--creme);
    border:1px solid rgba(245,239,231,0.3);
    font-size:24px;line-height:1;cursor:pointer;
  }
  .tdo-lightbox-close:hover{background:rgba(11,42,43,0.95);border-color:var(--gold);}
  .tdo-lightbox-close:focus-visible{outline:2px solid var(--gold);outline-offset:2px;}

  /* Oberstufe */
  .tdo-upper{
    background:#1F3F8A;color:#fff;padding:var(--space-section) 0;scroll-margin-top:110px;
    background-image:radial-gradient(circle, rgba(255,226,0,0.09) 0 2px, transparent 3px);
    background-size:22px 22px;
  }
  .tdo-upper .tdo-section-kicker{color:#FFE200;}
  .tdo-upper h2{
    font-family:var(--sans);font-weight:800;font-size:clamp(36px,4.6vw,64px);line-height:1.02;
    letter-spacing:-0.03em;margin:0 0 20px;color:#fff;
  }
  .tdo-upper h2 span{color:#FFE200;}
  .tdo-upper .tdo-lead{color:rgba(255,255,255,0.88);max-width:620px;}
  .tdo-upper-list{list-style:none;margin:32px 0 0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .tdo-upper-list li{
    display:flex;gap:12px;align-items:flex-start;
    background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.18);
    padding:16px 18px;font-family:var(--sans);font-size:15.5px;line-height:1.5;
  }
  .tdo-upper-list li::before{
    content:"";flex:none;width:10px;height:10px;margin-top:6px;border-radius:50%;background:#FFE200;
  }
  .tdo-upper .row{display:flex;flex-wrap:wrap;gap:14px;margin-top:32px;}
  .tdo-upper .btn-yellow{
    display:inline-flex;align-items:center;gap:8px;background:#FFE200;color:#1F3F8A;
    font-family:var(--sans);font-weight:700;font-size:15px;padding:13px 20px;border-radius:4px;text-decoration:none;
  }
  .tdo-upper .btn-yellow:hover{background:#fff;}
  .tdo-upper a:focus-visible{outline:2px solid #FFE200;outline-offset:3px;}
  .tdo-upper-posters{display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start;}
  .tdo-upper-posters figure{margin:0;}
  .tdo-upper-posters figure:nth-child(1){transform:rotate(-2deg);}
  .tdo-upper-posters figure:nth-child(2){transform:rotate(2deg);margin-top:40px;}
  .tdo-upper-posters .tdo-poster-link img{box-shadow:0 24px 50px -20px rgba(0,0,0,0.6);}


  @media (max-width:960px){
    .tdo-who-grid{grid-template-columns:1fr;gap:16px;}
    .tdo-split{grid-template-columns:1fr;gap:36px;}
    .tdo-poster{position:static;max-width:380px;}
    .tdo-upper-list{grid-template-columns:1fr;}
    .tdo-upper-posters{max-width:520px;}
    .tdo-who,.tdo-kids,.tdo-upper{padding-top:var(--space-section-sm);padding-bottom:var(--space-section-sm);}
  }
  @media (max-width:640px){
    .tdo-who-card{grid-template-columns:1fr 92px;gap:16px;padding:22px 20px;}
    .tdo-offers,.tdo-parents{grid-template-columns:1fr;}
  }
</style>

<main id="top">

<OpenDayHero
  title="Willkommen an der"
  titleLine2="UNESCO-Schule"
  lede="Am 5. Dezember 2026 öffnen wir unsere Türen. Wir laden alle interessierten Kinder der 4. Klassen mit ihren Eltern und SchülerInnen der Stufe 10 ein, sich ein Bild von uns und unserem Schulleben zu machen."
/>

<!-- ===================== ZIELGRUPPEN ===================== -->
<section class="tdo-who" aria-label="Für wen">
  <div class="container">
    <div class="tdo-who-grid">
      <a class="tdo-who-card" href="#klasse-5">
        <div>
          <span class="kicker">Klasse 4 und Eltern</span>
          <h2>Ihr Kind kommt 2027 in die 5. Klasse?</h2>
          <p>Lehrkräfte der neuen 5 kennenlernen, Beratung zur Erprobungsstufe, Mitmachangebote für Kinder</p>
          <span class="go">Zur Klasse 5 <span aria-hidden="true">↓</span></span>
        </div>
        <img src={link(posters.grundschule.img)} alt="" width="707" height="1000" loading="lazy">
      </a>
      <a class="tdo-who-card upper" href="#oberstufe">
        <div>
          <span class="kicker">Nach Klasse 10</span>
          <h2>Von hier zum Abi: Neustart in der Oberstufe</h2>
          <p>Beratung durch das Oberstufenteam, Rundgang mit unseren Schülerinnen und Schülern</p>
          <span class="go">Zur EF <span aria-hidden="true">↓</span></span>
        </div>
        <img src={link(posters.abi.img)} alt="" width="707" height="1000" loading="lazy">
      </a>
    </div>
  </div>
</section>

<!-- ===================== KLASSE 4 UND ELTERN ===================== -->
<section class="tdo-kids" id="klasse-5" aria-labelledby="tdo-kids-h">
  <div class="container">
    <div class="tdo-split">
      <div>
        <span class="tdo-section-kicker">Für Kinder der 4. Klassen und ihre Eltern</span>
        <h2 class="tdo-h2" id="tdo-kids-h">Die Erprobungsstufe kennenlernen</h2>
        <p class="tdo-lead">Am Tag der offenen Tür lernen Sie die Lehrkräfte der neuen fünften Klassen im persönlichen Gespräch kennen. Unser Erprobungsstufenkoordinator berät Sie zum Übergang von der Grundschule, zu den Profilen WortArt⁺ und Forscher² und zur Anmeldung.</p>

        <h3 class="tdo-subhead">Für Eltern</h3>
        <ul class="tdo-parents">
          {parentOffers.map((o) => (
            <li>
              <h4>{o.title}</h4>
              <p>{o.text}</p>
            </li>
          ))}
        </ul>

        <h3 class="tdo-subhead">Für Kinder</h3>
        <ul class="tdo-offers">
          {kidsOffers.map((o) => (
            <li class={`tdo-offer tone-${o.tone}`}>
              <h4>{o.title}</h4>
              <p>{o.text}</p>
            </li>
          ))}
        </ul>

        <p class="tdo-note">Mehr zur Erprobungsstufe finden Sie auf unserer <a href={link("Erprobungsstufe.html")}>Seite zur Klasse 5 und 6</a>. Beim <a href={link("elterninformationsabend-5-klasse-essen.html")}>Elterninformationsabend am 20. Januar 2027</a> erfahren Sie alles zur Anmeldung.</p>
      </div>

      <aside class="tdo-poster" aria-label="Plakat für Klasse 4 und Eltern">
        <button type="button" class="tdo-poster-link" data-full={link(posters.grundschule.img)} data-alt={posters.grundschule.alt} aria-label={posters.grundschule.label}>
          <img src={link(posters.grundschule.img)} alt="" width="707" height="1000" loading="lazy">
        </button>
      </aside>
    </div>
  </div>
</section>

<!-- ===================== OBERSTUFE ===================== -->
<section class="tdo-upper" id="oberstufe" aria-labelledby="tdo-upper-h">
  <div class="container">
    <div class="tdo-split">
      <div>
        <span class="tdo-section-kicker">Für Schülerinnen und Schüler der Klasse 10</span>
        <h2 id="tdo-upper-h">Von hier <span>zum Abi.</span></h2>
        <p class="tdo-lead">Du bist in der 10. Klasse und möchtest Abitur machen? In unserer Oberstufe startest du in der Einführungsphase (EF) gemeinsam mit vielen anderen, die neu dazukommen. Am Tag der offenen Tür lernst du die Oberstufe kennen.</p>
        <ul class="tdo-upper-list">
          {upperOffers.map((o) => <li>{o}</li>)}
        </ul>
        <div class="row">
          <a class="btn-yellow" href={link("Oberstufe.html")}>Mehr zur Oberstufe <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="tdo-upper-posters">
        <figure>
          <button type="button" class="tdo-poster-link" data-full={link(posters.abi.img)} data-alt={posters.abi.alt} aria-label={posters.abi.label}>
            <img src={link(posters.abi.img)} alt="" width="707" height="1000" loading="lazy">
          </button>
        </figure>
        <figure>
          <button type="button" class="tdo-poster-link" data-full={link(posters.oberstufe.img)} data-alt={posters.oberstufe.alt} aria-label={posters.oberstufe.label}>
            <img src={link(posters.oberstufe.img)} alt="" width="707" height="1000" loading="lazy">
          </button>
        </figure>
      </div>
    </div>
  </div>
</section>


<dialog class="tdo-lightbox" id="tdoLightbox" aria-label="Plakat in groß">
  <button type="button" class="tdo-lightbox-close" aria-label="Schließen">×</button>
  <img alt="" />
</dialog>
<script is:inline>
  (function(){
    var box = document.getElementById("tdoLightbox");
    if (!box || typeof box.showModal !== "function") return;
    var img = box.querySelector("img");
    document.querySelectorAll(".tdo-poster-link").forEach(function(btn){
      btn.addEventListener("click", function(){
        img.src = btn.getAttribute("data-full");
        img.alt = btn.getAttribute("data-alt") || "";
        box.showModal();
      });
    });
    box.querySelector(".tdo-lightbox-close").addEventListener("click", function(){ box.close(); });
    // Klick neben das Plakat schließt ebenfalls
    box.addEventListener("click", function(e){ if (e.target === box) box.close(); });
  })();
</script>

</main>
</BaseLayout>
