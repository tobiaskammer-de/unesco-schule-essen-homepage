---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { getSingle } from "../lib/pageContent";
import { safeBold, safeRichLink } from "../lib/safeMarkup";

const page: any = await getSingle("pageSprachen");
---
<BaseLayout
  title="Sprachen · UNESCO-Schule Essen"
  description="Fremdsprachenkonzept der UNESCO-Schule Essen: Englisch ab Klasse 5, Französisch oder Latein ab Klasse 7, dritte Fremdsprache ab Klasse 9 sowie Einstieg in der Oberstufe."
>
<style is:global>
  /* ---------- Sprachen ---------- */

  /* Sprachenfolge — Stages-Grid */
  .spr-journey{background:var(--offwhite);padding:var(--space-section) 0;}
  .spr-journey .head{max-width:820px;margin:0 0 56px;}
  .spr-journey .head .eyebrow{display:block;margin-bottom:14px;}
  .spr-journey .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.2vw,44px);line-height:1.15;letter-spacing:-0.015em;
    color:var(--petrol);margin:0 0 16px;
  }
  .spr-journey .head p{
    font-family:var(--sans);font-size:17px;line-height:1.65;color:var(--stein);
    max-width:680px;margin:0;
  }
  /* Sprachen-Roadmap: 3 Stufen (Pflicht → Wahl → Erweiterung) */
  .spr-roadmap{
    display:flex;flex-direction:column;gap:0;
    position:relative;
  }
  .spr-row{
    display:grid;grid-template-columns:160px 1fr;gap:32px;align-items:stretch;
    padding:28px 0;
    border-bottom:1px solid var(--hairline);
    position:relative;
  }
  .spr-row:last-child{border-bottom:0;}
  .spr-row-axis{
    display:flex;flex-direction:column;justify-content:center;gap:6px;
    padding-top:6px;
  }
  .spr-row-axis .klasse{
    font-family:var(--serif);font-weight:500;font-size:28px;line-height:1;
    color:var(--petrol);letter-spacing:-0.02em;
    font-variant-numeric:tabular-nums;
  }
  .spr-row-axis .label{
    font-family:var(--sans);font-size:11px;font-weight:600;
    letter-spacing:0.14em;text-transform:uppercase;color:var(--bordeaux);
  }
  .spr-row-axis .label.gold{color:var(--gold-deep);}

  /* Stage Card (gemeinsam) */
  .spr-stage{
    background:#fff;border:1px solid var(--hairline);
    border-top:var(--card-accent-width) solid var(--petrol);
    padding:24px 28px;
    display:flex;flex-direction:column;gap:8px;
    position:relative;
    transition:transform var(--transition), box-shadow var(--transition);
  }
  .spr-stage:hover{
    transform:translateY(var(--card-hover-lift));
    box-shadow:0 16px 40px -22px rgba(14,77,79,0.3);
  }
  @media (prefers-reduced-motion: reduce){.spr-stage:hover{transform:none;}}
  .spr-stage h3{
    font-family:var(--serif);font-weight:500;font-size:22px;line-height:1.2;
    color:var(--petrol);letter-spacing:-0.01em;margin:0;
  }
  .spr-stage p{
    font-family:var(--sans);font-size:15px;line-height:1.6;color:var(--tinte);margin:0;
  }

  /* Klasse 5 — eine breite Card */
  .spr-row-pflicht .spr-cards{display:block;}
  .spr-row-pflicht .spr-stage{
    border-top-color:var(--petrol);
  }

  /* Klasse 7 — drei Cards nebeneinander mit ODER-Trennern */
  .spr-row-wahl .spr-cards{
    display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:16px;align-items:stretch;
  }
  .spr-row-wahl .spr-or{
    display:flex;align-items:center;justify-content:center;
    font-family:var(--serif);font-style:italic;font-size:18px;
    color:var(--bordeaux);letter-spacing:0.04em;
    padding:0 4px;
  }
  .spr-row-wahl .spr-stage{border-top-color:var(--bordeaux);}
  /* Spanisch — neu im Angebot: Gold-Akzent + Badge */
  .spr-row-wahl .spr-stage-neu{border-top-color:var(--gold);}
  .neu-badge{
    display:inline-block;vertical-align:middle;
    font-family:var(--sans);font-size:10px;font-weight:700;
    letter-spacing:0.1em;text-transform:uppercase;
    color:var(--gold-deep);background:rgba(212,165,116,0.18);
    padding:2px 8px;border-radius:999px;margin-left:8px;
    position:relative;top:-2px;
  }

  /* Klasse 9 — schmale Erweiterungs-Card rechtsbündig unter Latein */
  .spr-row-erweiterung .spr-cards{
    display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:stretch;
  }
  .spr-row-erweiterung .spr-cards > .filler{
    /* leerer linker Bereich, bleibt frei zur visuellen Auflockerung */
    display:none;
  }
  .spr-row-erweiterung .spr-stage{
    border-top-color:var(--gold);
    grid-column:2 / 3;
    background:linear-gradient(180deg, rgba(212,165,116,0.10) 0%, #fff 100%);
  }
  /* Verbindung: Strich + Punkt sitzen mittig auf der 3.-FS-Karte und fluchten
     exakt — beide werden über die Karte zentriert (left:50% + translateX(-50%)),
     unabhängig von ihrer Breite. */
  .spr-row-erweiterung .spr-stage::before{
    content:"";
    position:absolute;
    /* zieht von oberhalb der Karte herunter bis zur Spitze des Punkts */
    top:-56px;left:50%;
    width:2px;height:49px;
    background:linear-gradient(180deg, var(--bordeaux) 0%, var(--gold) 100%);
    transform:translateX(-50%);
  }
  .spr-row-erweiterung .spr-stage::after{
    content:"";
    position:absolute;
    /* Raute zentriert auf der Oberkante der Karte */
    top:-5px;left:50%;
    width:10px;height:10px;
    background:var(--gold);
    transform:translate(-50%,0) rotate(45deg);
  }

  /* Pflicht/Wahl/Optional Pill innerhalb der Karte */
  .spr-stage .pill{
    align-self:flex-start;
    font-family:var(--sans);font-size:10.5px;font-weight:600;
    letter-spacing:0.12em;text-transform:uppercase;
    padding:3px 8px;
    margin-bottom:4px;
  }
  .spr-stage .pill.is-pflicht{color:var(--petrol);background:rgba(14,77,79,0.08);}
  .spr-stage .pill.is-wahl{color:var(--bordeaux);background:rgba(110,38,57,0.08);}
  .spr-stage .pill.is-erweiterung{color:var(--gold-deep);background:rgba(212,165,116,0.18);}

  /* Oberstufe — normale Sektion mit dezentem Gold-Akzent links */
  .spr-oberstufe{
    background:var(--creme);padding:var(--space-section) 0;
    border-top:1px solid var(--hairline);
  }
  .spr-oberstufe .inner{
    max-width:880px;margin:0 auto;
    border-left:3px solid var(--gold);
    padding:6px 0 6px 36px;
  }
  .spr-oberstufe .eyebrow{display:block;margin-bottom:14px;color:var(--gold-deep);}
  .spr-oberstufe h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(28px,3vw,40px);line-height:1.2;letter-spacing:-0.015em;
    color:var(--petrol);margin:0 0 16px;
  }
  .spr-oberstufe h2 em{font-style:italic;color:var(--bordeaux);font-weight:500;}
  .spr-oberstufe p{
    font-family:var(--sans);font-size:17px;line-height:1.7;color:var(--tinte);margin:0;
    max-width:760px;
  }

  /* Sprache erleben — Pillars */
  .spr-experience{background:var(--offwhite);padding:var(--space-section) 0;}
  .spr-experience .head{max-width:820px;margin:0 0 56px;}
  .spr-experience .head .eyebrow{display:block;margin-bottom:14px;}
  .spr-experience .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.2vw,44px);line-height:1.15;letter-spacing:-0.015em;
    color:var(--petrol);margin:0 0 16px;
  }
  .spr-experience .head p{
    font-family:var(--sans);font-size:17px;line-height:1.65;color:var(--stein);
    max-width:680px;margin:0;
  }
  .spr-pillars{
    display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px;
  }
  .spr-pillar{
    border-top:1px solid var(--hairline);
    padding-top:22px;
    display:flex;flex-direction:column;gap:10px;
  }
  .spr-pillar h3{
    font-family:var(--serif);font-weight:500;font-size:22px;line-height:1.25;
    color:var(--petrol);letter-spacing:-0.008em;margin:0;
  }
  .spr-pillar p{
    font-family:var(--sans);font-size:15.5px;line-height:1.65;color:var(--tinte);margin:0;
  }

  /* Vorteile (Häkchen) */
  .spr-advantages{
    background:var(--creme);padding:var(--space-section) 0;
    border-top:1px solid var(--hairline);
  }
  .spr-advantages-grid{
    display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);
    gap:64px;align-items:center;
  }
  .spr-advantages .head .eyebrow{display:block;margin-bottom:14px;}
  .spr-advantages .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.2vw,42px);line-height:1.15;letter-spacing:-0.015em;
    color:var(--petrol);margin:0;
  }
  .spr-checklist{
    list-style:none;margin:0;padding:0;
    display:flex;flex-direction:column;gap:16px;
  }
  .spr-checklist li{
    display:grid;grid-template-columns:auto 1fr;gap:18px;align-items:start;
    font-family:var(--sans);font-size:17px;line-height:1.55;color:var(--tinte);
    padding:14px 0;border-bottom:1px solid var(--hairline);
  }
  .spr-checklist li:last-child{border-bottom:0;}
  .spr-checklist .check{
    width:28px;height:28px;flex-shrink:0;
    background:rgba(14,77,79,0.08);color:var(--petrol);
    display:flex;align-items:center;justify-content:center;
    border-radius:50%;
    margin-top:1px;
  }
  .spr-checklist .check svg{width:14px;height:14px;}

  /* Closing */
  .spr-closing{
    background:var(--petrol);color:var(--creme);
    padding:var(--space-section) 0;
  }
  .spr-closing .container{max-width:840px;text-align:center;}
  .spr-closing .eyebrow{color:rgba(245,239,231,0.55);display:block;margin-bottom:16px;}
  .spr-closing h2{
    font-family:var(--serif);font-weight:500;font-style:italic;
    font-size:clamp(28px,3.2vw,44px);line-height:1.2;
    color:var(--creme);letter-spacing:-0.015em;margin:0 0 26px;
  }
  .spr-closing h2 em{color:var(--gold);font-style:italic;}
  .spr-closing p{
    font-family:var(--sans);font-size:17.5px;line-height:1.7;
    color:rgba(245,239,231,0.9);max-width:720px;margin:0 auto 32px;
  }
  .spr-closing .cta-row{
    display:flex;justify-content:center;gap:16px;flex-wrap:wrap;
  }

  @media (max-width:960px){
    .spr-pillars{grid-template-columns:1fr;gap:20px;}
    .spr-advantages-grid{grid-template-columns:1fr;gap:32px;}
    .spr-oberstufe .inner{padding-left:20px;}
    .spr-journey,.spr-oberstufe,.spr-experience,.spr-advantages,.spr-closing{
      padding:var(--space-section-sm) 0;
    }
    /* Roadmap: Achse über die Karten ziehen statt seitlich */
    .spr-row{grid-template-columns:1fr;gap:14px;padding:24px 0;}
    .spr-row-axis{padding-top:0;}
    .spr-row-axis .klasse{font-size:24px;}
    .spr-row-erweiterung::before,
    .spr-row-erweiterung::after{display:none;}
    /* drei Wahl-Karten unter 960px untereinander statt gequetscht */
    .spr-row-wahl .spr-cards{grid-template-columns:1fr;}
    .spr-row-wahl .spr-or{padding:8px 0;font-size:16px;}
  }
  @media (max-width:560px){
    .spr-row-wahl .spr-cards{grid-template-columns:1fr;}
    .spr-row-wahl .spr-or{padding:8px 0;font-size:16px;}
    .spr-row-erweiterung .spr-cards{grid-template-columns:1fr;}
    .spr-row-erweiterung .spr-stage{grid-column:1 / -1;}
  }
</style>

<main id="top">

<PageHero
  variant="feature"
  image={page.hero.image || "assets/sp-weltoffen.jpg"}
  imageAlt={page.hero.imageAlt || ""}
  imageCredit="UNESCO-Schule Essen"
>
  <Fragment slot="eyebrow">{page.hero.eyebrow}</Fragment>
  <Fragment slot="title">{page.hero.title}{page.hero.titleHighlight && <><br /><em>{page.hero.titleHighlight}</em></>}</Fragment>
  {page.hero.lede && <Fragment slot="lede">{page.hero.lede}</Fragment>}
</PageHero>

<section class="spr-journey" aria-label="Sprachenfolge">
  <div class="container">
    <div class="head">
      {page.journey?.eyebrow && <span class="eyebrow">{page.journey.eyebrow}</span>}
      <h2>{page.journey?.title}</h2>
      {page.journey?.body && <p>{page.journey.body}</p>}
    </div>
    <div class="spr-roadmap">
      {/* Klasse 5 — Pflicht für alle */}
      <div class="spr-row spr-row-pflicht">
        <div class="spr-row-axis">
          <span class="klasse">Klasse 5</span>
          <span class="label">Pflicht für alle</span>
        </div>
        <div class="spr-cards">
          <article class="spr-stage">
            <span class="pill is-pflicht">Englisch · für alle</span>
            <h3>Englisch</h3>
            <p>{page.journey?.stages?.[0]?.body}</p>
          </article>
        </div>
      </div>

      {/* Klasse 7 — Wahl zwischen Französisch, Spanisch ODER Latein */}
      <div class="spr-row spr-row-wahl">
        <div class="spr-row-axis">
          <span class="klasse">Klasse 7</span>
          <span class="label">Wahl: Französisch, Spanisch oder Latein</span>
        </div>
        <div class="spr-cards">
          <article class="spr-stage">
            <span class="pill is-wahl">2. Fremdsprache</span>
            <h3>Französisch</h3>
            <p>{page.journey?.stages?.[1]?.body}</p>
          </article>
          <span class="spr-or" aria-hidden="true">oder</span>
          <article class="spr-stage spr-stage-neu">
            <span class="pill is-wahl">2. Fremdsprache</span>
            <h3>Spanisch <span class="neu-badge">Geplant</span></h3>
            <p>{page.journey?.stages?.[2]?.body}</p>
          </article>
          <span class="spr-or" aria-hidden="true">oder</span>
          <article class="spr-stage">
            <span class="pill is-wahl">2. Fremdsprache</span>
            <h3>Latein</h3>
            <p>{page.journey?.stages?.[3]?.body}</p>
          </article>
        </div>
      </div>

      {/* Klasse 9 — Erweiterung: Französisch als 3. FS, wenn Latein gewählt wurde */}
      <div class="spr-row spr-row-erweiterung">
        <div class="spr-row-axis">
          <span class="klasse">Klasse 9</span>
          <span class="label gold">Optional bei Latein-Vorwahl</span>
        </div>
        <div class="spr-cards">
          <div class="filler"></div>
          <article class="spr-stage">
            <span class="pill is-erweiterung">+ 3. Fremdsprache</span>
            <h3>Französisch <span style="color:var(--gold-deep);font-style:italic;">als Erweiterung</span></h3>
            <p>{page.journey?.stages?.[4]?.body}</p>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="spr-experience" aria-label="Sprache erleben">
  <div class="container">
    <div class="head">
      {page.experience?.eyebrow && <span class="eyebrow">{page.experience.eyebrow}</span>}
      <h2>{page.experience?.title}</h2>
      {page.experience?.body && <p>{page.experience.body}</p>}
    </div>
    <div class="spr-pillars">
      {(page.experience?.pillars ?? []).map((p: any) => (
        <article class="spr-pillar">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="spr-closing" aria-label="Abschluss">
  <div class="container">
    {page.closing?.eyebrow && <span class="eyebrow">{page.closing.eyebrow}</span>}
    <h2>{page.closing?.title}{page.closing?.titleHighlight && <><br /><em>{page.closing.titleHighlight}</em></>}</h2>
    <p set:html={safeRichLink(page.closing?.body)} />
    {page.closing?.ctaLabel && page.closing?.ctaHref && (
      <div class="cta-row">
        <a href={page.closing.ctaHref} class="btn btn-gold">{page.closing.ctaLabel} <span class="arrow">→</span></a>
        <a href="Anmeldung.html" class="btn btn-secondary" style="color:var(--creme);border-color:rgba(245,239,231,0.4);">Zur Anmeldung <span class="arrow">→</span></a>
      </div>
    )}
  </div>
</section>

</main>
</BaseLayout>
