---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { getSingle } from "../lib/pageContent";

const page: any = await getSingle("pageStundentafel");
---
<BaseLayout title="Stundentafeln und Unterrichtsraster · UNESCO-Schule Essen">
<style is:global>
  /* ---------- Stundentafel ---------- */
  .st-intro{background:var(--creme);padding:var(--space-section) 0;}
  .st-intro-grid{
    display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);
    gap:56px;align-items:start;
  }
  .st-intro h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.4vw,44px);line-height:1.12;
    color:var(--petrol);letter-spacing:-0.015em;margin:0;
  }
  .st-intro p{
    font-family:var(--sans);font-size:17px;line-height:1.7;color:var(--tinte);
    margin:0 0 16px;
  }
  .st-intro p em{font-style:italic;color:var(--bordeaux);}

  /* Unterrichtsraster — shared time table */
  .st-raster{background:var(--offwhite);padding:var(--space-section) 0;}
  .st-raster .head{max-width:780px;margin:0 0 48px;}
  .st-raster .head .eyebrow{display:block;margin-bottom:14px;}
  .st-raster .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.2vw,44px);line-height:1.15;letter-spacing:-0.015em;
    color:var(--petrol);margin:0 0 16px;
  }
  .st-raster .head p{
    font-family:var(--sans);font-size:17px;line-height:1.65;color:var(--stein);
    max-width:640px;margin:0;
  }
  .raster-table{
    background:#fff;border:1px solid var(--hairline);
    border-top:var(--card-accent-width) solid var(--petrol);
    max-width:680px;
    font-variant-numeric:tabular-nums;
  }
  .raster-row{
    display:grid;grid-template-columns:minmax(140px,1fr) 2fr;
    border-bottom:1px solid var(--hairline);
  }
  .raster-row:last-child{border-bottom:0;}
  .raster-row .lbl{
    padding:14px 22px;font-family:var(--sans);font-weight:500;font-size:15px;
    color:var(--tinte);
  }
  .raster-row .time{
    padding:14px 22px;font-family:var(--sans);font-size:15px;
    color:var(--stein);border-left:1px solid var(--hairline);
  }
  .raster-row.pause{
    grid-template-columns:1fr;
    background:var(--creme);
    border-top:1px solid var(--hairline);
    border-bottom:1px solid var(--hairline);
  }
  .raster-row.pause .lbl{
    color:var(--petrol);font-weight:500;font-size:13px;
    letter-spacing:0.08em;text-transform:uppercase;text-align:center;
    padding:10px 16px;
  }

  /* Stundentafel — big subject table */
  .st-table-wrap{background:var(--creme);padding:var(--space-section) 0;border-top:1px solid var(--hairline);}
  .st-table-wrap .head{max-width:820px;margin:0 0 40px;}
  .st-table-wrap .head .eyebrow{display:block;margin-bottom:14px;}
  .st-table-wrap .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.2vw,44px);line-height:1.15;letter-spacing:-0.015em;
    color:var(--petrol);margin:0 0 16px;
  }
  .st-table-wrap .head .tag{
    font-family:var(--sans);font-size:12px;font-weight:500;
    letter-spacing:0.1em;text-transform:uppercase;color:var(--stein);
  }
  .st-table-wrap .head p{
    font-family:var(--sans);font-size:17px;line-height:1.65;color:var(--stein);
    max-width:640px;margin:14px 0 0;
  }

  .st-table-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;}
  .st-table{
    width:100%;min-width:1040px;
    border-collapse:collapse;
    background:#fff;border:1px solid var(--hairline);
    border-top:var(--card-accent-width) solid var(--petrol);
    font-variant-numeric:tabular-nums;
  }
  .st-table caption{
    caption-side:top;text-align:left;
    padding:18px 22px 14px;
    font-family:var(--sans);font-size:13px;font-weight:600;
    letter-spacing:0.1em;text-transform:uppercase;color:var(--petrol);
    background:#fff;border-bottom:1px solid var(--hairline);
  }
  .st-table thead th{
    background:var(--offwhite);
    font-family:var(--sans);font-weight:600;font-size:13px;
    letter-spacing:0.08em;text-transform:uppercase;color:var(--petrol);
    padding:14px 16px;text-align:center;
    border-bottom:1px solid var(--hairline);
    white-space:nowrap;
  }
  .st-table thead th.subject{text-align:left;}
  .st-table tbody th{
    text-align:left;font-family:var(--sans);font-weight:500;font-size:15px;
    color:var(--tinte);padding:12px 16px;
    border-bottom:1px solid var(--hairline);
  }
  .st-table tbody td{
    text-align:center;font-family:var(--sans);font-size:15px;
    color:var(--tinte);padding:12px 16px;
    border-bottom:1px solid var(--hairline);
  }
  .st-table tbody td.vorgabe{
    text-align:left;font-size:13.5px;color:var(--stein);
  }
  .st-table tbody td.sum{
    font-weight:600;color:var(--petrol);
  }
  .st-table tbody tr.group-head th,
  .st-table tbody tr.group-head td{
    background:var(--creme);
    font-family:var(--serif);font-weight:500;font-size:16px;
    color:var(--petrol);letter-spacing:-0.005em;
    padding:14px 16px;
  }
  .st-table tbody tr.group-head th{text-align:left;}
  .st-table tbody tr.total th,
  .st-table tbody tr.total td{
    background:var(--petrol);color:var(--creme);
    font-weight:600;font-size:15px;
    padding:14px 16px;
  }
  .st-table tbody tr.total th{font-family:var(--sans);}
  .st-table tbody tr.subtotal th,
  .st-table tbody tr.subtotal td{
    background:var(--offwhite);
    font-weight:600;color:var(--petrol);
  }
  .st-table sup{
    font-size:10px;font-weight:600;color:var(--bordeaux);
    vertical-align:super;line-height:0;margin-left:2px;
  }
  .st-table .em{font-style:italic;color:var(--stein);}

  .st-scroll-hint{
    display:none;
    font-family:var(--sans);font-size:12.5px;color:var(--stein);
    margin:10px 0 0;letter-spacing:0.02em;
  }
  @media (max-width:960px){
    .st-scroll-hint{display:block;}
  }

  /* Footnotes */
  .st-notes{background:var(--offwhite);padding:var(--space-section) 0;}
  .st-notes .inner{
    background:#fff;border:1px solid var(--hairline);
    border-left:var(--card-accent-width) solid var(--gold);
    padding:32px 40px;max-width:820px;
  }
  .st-notes h3{
    font-family:var(--sans);font-weight:600;font-size:12px;
    letter-spacing:0.14em;text-transform:uppercase;color:var(--gold-deep);
    margin:0 0 14px;
  }
  .st-notes ol{
    list-style:none;margin:0;padding:0;counter-reset:fn;
    display:flex;flex-direction:column;gap:8px;
  }
  .st-notes ol li{
    counter-increment:fn;
    position:relative;padding-left:28px;
    font-family:var(--sans);font-size:14.5px;line-height:1.6;color:var(--tinte);
  }
  .st-notes ol li::before{
    content:counter(fn);
    position:absolute;left:0;top:0;
    font-size:10px;font-weight:600;color:var(--bordeaux);
    line-height:1.3;
  }

  /* Dummy preview (placeholder for SII / Stundenplan-Grafik) */
  .st-dummy{background:var(--offwhite);padding:var(--space-section) 0;border-top:1px solid var(--hairline);}
  .st-dummy .head{max-width:780px;margin:0 0 32px;}
  .st-dummy .head .eyebrow{display:block;margin-bottom:14px;}
  .st-dummy .head h2{
    font-family:var(--serif);font-weight:500;font-size:clamp(28px,3vw,40px);
    line-height:1.15;color:var(--petrol);letter-spacing:-0.015em;margin:0 0 14px;
  }
  .st-dummy .head p{
    font-family:var(--sans);font-size:16.5px;line-height:1.65;color:var(--stein);
    max-width:640px;margin:0;
  }
  .st-dummy .placeholder{
    background:#fff;border:1px dashed var(--hairline);
    aspect-ratio:16/6;
    display:flex;align-items:center;justify-content:center;
    font-family:var(--sans);font-size:13.5px;letter-spacing:0.08em;
    text-transform:uppercase;color:var(--stein);
    max-width:960px;
  }

  @media (max-width:960px){
    .st-intro-grid{grid-template-columns:1fr;gap:32px;}
    .raster-row{grid-template-columns:140px 1fr;}
    .legend-grid{grid-template-columns:1fr;}
    .st-intro,.st-raster,.st-table-wrap,.st-notes,.st-dummy{padding:var(--space-section-sm) 0;}
    .st-notes .inner{padding:24px 24px;}
  }
  @media (max-width:400px){
    /* Tabellen auf Mini-Screens: knapperes Padding + kleinere Schrift */
    .st-table thead th,
    .st-table tbody th,
    .st-table tbody td{padding:10px 10px;font-size:13.5px;}
    .st-table caption{padding:14px 16px 12px;font-size:12px;}
    .raster-row{grid-template-columns:110px 1fr;}
    .raster-row .lbl,.raster-row .time{padding:12px 14px;font-size:14px;}
  }
</style>

<main id="top">

<PageHero variant="feature">
  <Fragment slot="eyebrow">{page.hero.eyebrow}</Fragment>
  <Fragment slot="title">{page.hero.title}{page.hero.titleHighlight && <><br />und {page.hero.titleHighlight.replace(/^und /, "")}</>}</Fragment>
  {page.hero.lede && <Fragment slot="lede">{page.hero.lede}</Fragment>}
</PageHero>

<section class="st-raster" aria-label="Unterrichtsraster">
  <div class="container">
    <div class="head">
      <span class="eyebrow">Tagesstruktur</span>
      <h2>Das aktuelle Unterrichtsraster</h2>
      <p>45-Minuten-Stunden mit zwei großen Pausen am Vormittag und einer Mittagspause vor dem Nachmittagsunterricht.</p>
    </div>

    <div class="raster-table" role="table" aria-label="Unterrichtsraster nach Stunden">
      <div class="raster-row"><span class="lbl">1.&nbsp;Stunde</span><span class="time">08:05&nbsp;–&nbsp;08:50</span></div>
      <div class="raster-row"><span class="lbl">2.&nbsp;Stunde</span><span class="time">08:55&nbsp;–&nbsp;09:40</span></div>
      <div class="raster-row pause"><span class="lbl">1.&nbsp;große Pause</span></div>
      <div class="raster-row"><span class="lbl">3.&nbsp;Stunde</span><span class="time">10:00&nbsp;–&nbsp;10:45</span></div>
      <div class="raster-row"><span class="lbl">4.&nbsp;Stunde</span><span class="time">10:50&nbsp;–&nbsp;11:35</span></div>
      <div class="raster-row pause"><span class="lbl">2.&nbsp;große Pause</span></div>
      <div class="raster-row"><span class="lbl">5.&nbsp;Stunde</span><span class="time">11:55&nbsp;–&nbsp;12:40</span></div>
      <div class="raster-row"><span class="lbl">6.&nbsp;Stunde</span><span class="time">12:45&nbsp;–&nbsp;13:30</span></div>
      <div class="raster-row pause"><span class="lbl">Mittagspause</span></div>
      <div class="raster-row"><span class="lbl">7.&nbsp;Stunde</span><span class="time">13:50&nbsp;–&nbsp;14:35</span></div>
      <div class="raster-row"><span class="lbl">8.&nbsp;Stunde</span><span class="time">14:40&nbsp;–&nbsp;15:25</span></div>
      <div class="raster-row"><span class="lbl">9.&nbsp;Stunde</span><span class="time">15:25&nbsp;–&nbsp;16:10</span></div>
      <div class="raster-row"><span class="lbl">10.&nbsp;Stunde</span><span class="time">16:10&nbsp;–&nbsp;16:55</span></div>
    </div>
  </div>
</section>

<section class="st-table-wrap" aria-label="Stundentafel Sekundarstufe I">
  <div class="container">
    <div class="head">
      <span class="eyebrow">Wochenstunden je Fach</span>
      <h2>Stundentafel Sekundarstufe&nbsp;I</h2>
      <span class="tag">Stand Mai 2026 · APO-SI</span>
      <p>Die Tabelle zeigt die Wochenstunden pro Fach in den Klassen&nbsp;5 bis 10. Die Fachkürzel sind direkt hinter den Fachnamen aufgeführt.</p>
    </div>

    <div class="st-table-scroll">
      <table class="st-table">
        <caption>UNESCO-Schule Essen · Stundentafel Sekundarstufe&nbsp;I (Klassen 5 – 10)</caption>
        <thead>
          <tr>
            <th scope="col" class="subject">Lernbereich / Fach</th>
            <th scope="col">Vorgabe APO-SI</th>
            <th scope="col">Klasse 5</th>
            <th scope="col">Klasse 6</th>
            <th scope="col">Klasse 7</th>
            <th scope="col">Klasse 8</th>
            <th scope="col">Klasse 9</th>
            <th scope="col">Klasse 10</th>
            <th scope="col">Summe</th>
          </tr>
        </thead>
        <tbody>
          <tr><th scope="row">Deutsch (D)</th><td class="vorgabe">22</td><td>5</td><td>4</td><td>4</td><td>3</td><td>3</td><td>3</td><td class="sum">22</td></tr>

          <tr class="group-head"><th scope="row" colspan="9">Gesellschaftslehre &mdash; insgesamt 23</th></tr>
          <tr><th scope="row">Geschichte (GE)</th><td class="vorgabe">mind. 8</td><td>–</td><td>2</td><td>2</td><td>–</td><td>2</td><td>2</td><td class="sum">8</td></tr>
          <tr><th scope="row">Erdkunde (EK)</th><td class="vorgabe">mind. 7</td><td>–</td><td>2</td><td>2</td><td>2</td><td>–</td><td>1</td><td class="sum">7</td></tr>
          <tr><th scope="row">Politik &amp; Wirtschaft (PK&nbsp;&amp;&nbsp;WI)</th><td class="vorgabe">mind. 8</td><td>2</td><td>–</td><td>2</td><td>2</td><td>2</td><td>–</td><td class="sum">8</td></tr>

          <tr><th scope="row">Mathematik (M)</th><td class="vorgabe">22</td><td>4</td><td>5</td><td>4</td><td>3</td><td>3</td><td>3</td><td class="sum">22</td></tr>

          <tr class="group-head"><th scope="row" colspan="9">Informatik &mdash; insgesamt 2</th></tr>
          <tr><th scope="row">Informatik (IF)</th><td class="vorgabe">2</td><td>–</td><td>2</td><td>–</td><td>–</td><td>–</td><td>–</td><td class="sum">2</td></tr>

          <tr class="group-head"><th scope="row" colspan="9">Naturwissenschaften &mdash; insgesamt 23</th></tr>
          <tr><th scope="row">Biologie (BI)</th><td class="vorgabe">mind. 7</td><td>2</td><td>2</td><td>–</td><td>2</td><td>2</td><td>1<sup>1</sup></td><td class="sum">9</td></tr>
          <tr><th scope="row">Chemie (CH)</th><td class="vorgabe">mind. 7</td><td>–</td><td>–</td><td>1<sup>2</sup></td><td>2</td><td>2</td><td>2</td><td class="sum">7</td></tr>
          <tr><th scope="row">Physik (PH)</th><td class="vorgabe">mind. 7</td><td>–</td><td>2</td><td>1<sup>2</sup></td><td>2</td><td>1</td><td>1<sup>1</sup></td><td class="sum">7</td></tr>

          <tr class="group-head"><th scope="row" colspan="9">Sprachen &mdash; Englisch 22 · FUD 6 · 2.&nbsp;FS 15</th></tr>
          <tr><th scope="row">Englisch (E)</th><td class="vorgabe">22</td><td>5</td><td>4</td><td>4</td><td>3</td><td>3</td><td>3</td><td class="sum">22</td></tr>
          <tr><th scope="row">FUD<sup>3</sup> <span class="em">(anstelle L7)</span></th><td class="vorgabe">–</td><td>–</td><td>–</td><td>–</td><td>–</td><td>(3)</td><td>(3)</td><td class="sum em">(6)</td></tr>
          <tr><th scope="row">2.&nbsp;Fremdsprache (L/F)</th><td class="vorgabe">15</td><td>–</td><td>–</td><td>3</td><td>4</td><td>4</td><td>4</td><td class="sum">15</td></tr>

          <tr class="group-head"><th scope="row" colspan="9">Kunst und Musik &mdash; insgesamt 17</th></tr>
          <tr><th scope="row">Kunst (KU)</th><td class="vorgabe">mind. 7</td><td>2</td><td>2</td><td>1</td><td>2</td><td>–</td><td>2</td><td class="sum">9</td></tr>
          <tr><th scope="row">Musik (MU)</th><td class="vorgabe">mind. 7</td><td>2</td><td>1</td><td>2</td><td>–</td><td>2</td><td>1</td><td class="sum">8</td></tr>

          <tr class="group-head"><th scope="row" colspan="9">Religion und Sport</th></tr>
          <tr><th scope="row">Religion / Philosophie (ER/KR/PP)</th><td class="vorgabe">12</td><td>2</td><td>2</td><td>2</td><td>2</td><td>2</td><td>2</td><td class="sum">12</td></tr>
          <tr><th scope="row">Sport (SP)</th><td class="vorgabe">18</td><td>4</td><td>2<sup>4</sup></td><td>3</td><td>3</td><td>3</td><td>2</td><td class="sum">17</td></tr>

          <tr class="group-head"><th scope="row" colspan="9">Wahlpflicht &mdash; insgesamt 6</th></tr>
          <tr><th scope="row">3.&nbsp;FS Französisch · Informatik · Nachhaltige Gesellschaft · Bühnenwelten</th><td class="vorgabe">6</td><td>–</td><td>–</td><td>–</td><td>–</td><td>3</td><td>3</td><td class="sum">6</td></tr>

          <tr class="total"><th scope="row">Summe Kernstunden</th><td>–</td><td>28</td><td>30</td><td>31</td><td>30</td><td>30</td><td>31</td><td>181</td></tr>

          <tr class="group-head"><th scope="row" colspan="9">Ergänzungsstunden &mdash; insgesamt 0 – 6</th></tr>
          <tr><th scope="row">Ergänzung 3.&nbsp;FS Französisch<sup>5</sup></th><td class="vorgabe">+2</td><td>–</td><td>–</td><td>–</td><td>–</td><td>1</td><td>1</td><td class="sum">+2</td></tr>
          <tr><th scope="row">Profilkurs 5<sup>6</sup></th><td class="vorgabe">+2</td><td>2</td><td>–</td><td>–</td><td>–</td><td>–</td><td>–</td><td class="sum">+2</td></tr>
          <tr><th scope="row">Förderunterricht / Startchancen<sup>7</sup></th><td class="vorgabe">+2</td><td>–</td><td>–</td><td>1</td><td>1</td><td>–</td><td>–</td><td class="sum">+2</td></tr>

          <tr class="group-head"><th scope="row" colspan="9">Gesamt</th></tr>
          <tr><th scope="row">Vorgabe Wochenstunden</th><td class="vorgabe">–</td><td>28–30</td><td>28–30</td><td>30–33</td><td>30–33</td><td>30–33</td><td>30–33</td><td class="sum">182–190</td></tr>
          <tr class="total"><th scope="row">Gesamtwochenstunden<sup>8</sup></th><td>–</td><td>30</td><td>30</td><td>32</td><td>31</td><td>30/31</td><td>31/32</td><td>185 / 187</td></tr>
        </tbody>
      </table>
    </div>
    <p class="st-scroll-hint">Tabelle seitlich scrollen →</p>
  </div>
</section>

<section class="st-notes" aria-label="Anmerkungen zur Stundentafel">
  <div class="container">
    <div class="inner">
      <h3>Anmerkungen</h3>
      <ol>
        <li>Biologie und Physik werden in Klasse&nbsp;9 jeweils ein Halbjahr doppelstündig als Epochenfach unterrichtet (Wechsel zum Halbjahr).</li>
        <li>Chemie und Physik werden in Klasse&nbsp;7 jeweils ein Halbjahr doppelstündig als Epochenfach unterrichtet (Wechsel zum Halbjahr).</li>
        <li>FUD (Förder-Unterricht Deutsch) gilt nur für seiteneinsteigende Schülerinnen und Schüler mit Sprachfeststellungsprüfung in der Herkunftssprache.</li>
        <li>Laut Schulkonferenzbeschluss wurde eine Sportstunde aus dem Kernstundenbereich in den Bereich der Ergänzungsstunden verlegt (Profilkurs&nbsp;5); vgl. die Anlagen zur Stundentafel in der APO-SI.</li>
        <li>3.&nbsp;Fremdsprache = 4-stündig.</li>
        <li>2-stündiger Wahlkurs in Klasse&nbsp;5: WortArt⁺ oder Forscher².</li>
        <li>Förderstunde in Deutsch und Mathematik im Halbjahreswechsel.</li>
        <li>Abhängig von der Wahlpflichtwahl (ergänzende Stunde in Französisch).</li>
      </ol>
    </div>
  </div>
</section>

<section class="st-dummy" aria-label="Stundentafel Sekundarstufe II">
  <div class="container">
    <div class="head">
      <span class="eyebrow">In Vorbereitung</span>
      <h2>Stundentafel Sekundarstufe&nbsp;II</h2>
      <p>Eine entsprechende Übersicht zur gymnasialen Oberstufe (EF · Q1 · Q2) folgt an dieser Stelle in Kürze.</p>
    </div>
    <div class="placeholder">
      Platzhalter · Stundentafel SII folgt
    </div>
  </div>
</section>

</main>
</BaseLayout>
