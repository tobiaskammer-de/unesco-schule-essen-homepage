---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import MailLink from "../components/MailLink.astro";
import { getSingle } from "../lib/pageContent";
import { safeBreaks } from "../lib/safeMarkup";

const page: any = await getSingle("pageAnfahrt");
const school: any = await getSingle("siteSchool");
---
<BaseLayout title="Adresse und Anfahrt · UNESCO-Schule Essen" description="So erreichen Sie die UNESCO-Schule Essen, Steinmetzstraße 9: zu Fuß, mit Bus und Bahn oder mit dem Auto.">
<style is:global>
  .an-main{background:var(--offwhite);padding:var(--space-section) 0;}
  .an-grid{
    display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:56px;align-items:start;
  }
  .an-col h2{
    font-family:var(--serif);font-weight:500;font-size:28px;line-height:1.2;
    color:var(--petrol);letter-spacing:-0.01em;margin:0 0 18px;
  }
  .an-col .address{
    background:#fff;border:1px solid var(--hairline);
    border-left:3px solid var(--petrol);
    padding:28px 32px;
    font-family:var(--sans);font-size:16px;line-height:1.65;color:var(--tinte);
    margin:0 0 24px;
  }
  .an-col .address strong{
    font-family:var(--serif);font-weight:500;font-size:20px;
    color:var(--petrol);display:block;margin-bottom:6px;letter-spacing:-0.005em;
  }
  .an-col .address a{color:var(--petrol);font-weight:500;}
  .an-col .address a:hover{text-decoration:underline;}
  .an-col .contact-row{
    display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:8px;
  }
  .an-col .contact-row .cell{
    padding:14px 16px;background:#fff;border:1px solid var(--hairline);
    font-family:var(--sans);font-size:14.5px;color:var(--tinte);
  }
  .an-col .contact-row .cell .lbl{
    display:block;font-size:10.5px;font-weight:600;letter-spacing:0.14em;
    text-transform:uppercase;color:var(--stein);margin-bottom:4px;
  }

  /* Map */
  .map-wrap{
    position:relative;aspect-ratio:4/3;background:var(--creme);
    border:1px solid var(--hairline);overflow:hidden;
  }
  .map-wrap iframe{width:100%;height:100%;border:0;display:block;}
  /* Klick-zum-Laden-Platzhalter (Datenschutz: keine OSM-Übertragung ohne Zustimmung) */
  .map-consent{
    position:absolute;inset:0;display:flex;flex-direction:column;
    align-items:center;justify-content:center;text-align:center;gap:14px;
    padding:28px;background:linear-gradient(135deg, var(--petrol) 0%, var(--petrol-dark) 100%);
  }
  .map-consent-text{
    font-family:var(--sans);font-size:14.5px;line-height:1.6;color:rgba(245,239,231,0.92);
    max-width:42ch;margin:0;
  }
  .map-consent-text strong{color:#fff;}
  .map-consent-btn{
    background:var(--gold);color:var(--gold-text);border:0;
    padding:12px 26px;font-family:var(--sans);font-weight:600;font-size:14.5px;cursor:pointer;
    transition:background var(--transition-fast);
  }
  .map-consent-btn:hover{background:var(--gold-hover);}
  .map-consent-note{
    font-family:var(--sans);font-size:12.5px;color:rgba(245,239,231,0.7);margin:0;
  }
  .map-consent-note a{color:rgba(245,239,231,0.92);text-decoration:underline;}
  .map-link{
    display:inline-flex;align-items:center;gap:8px;margin-top:14px;
    font-family:var(--sans);font-size:14px;font-weight:500;color:var(--bordeaux);
  }
  .map-link:hover{color:var(--petrol-dark);}

  /* Transport options */
  .an-transport{background:var(--creme);padding:var(--space-section) 0;border-top:1px solid var(--hairline);}
  .an-transport .head{max-width:780px;margin:0 0 40px;}
  .an-transport .head .eyebrow{display:block;margin-bottom:14px;}
  .an-transport .head h2{
    font-family:var(--serif);font-weight:500;font-size:clamp(28px,3vw,40px);line-height:1.15;
    color:var(--petrol);letter-spacing:-0.015em;margin:0;
  }
  .transport-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;}
  .transport-card{
    background:#fff;border:1px solid var(--hairline);padding:var(--card-padding);
    display:flex;flex-direction:column;gap:14px;
    border-top:var(--card-accent-width) solid var(--petrol);
  }
  .transport-card .mode{
    font-family:var(--sans);font-size:11px;font-weight:600;
    letter-spacing:0.14em;text-transform:uppercase;color:var(--petrol);
  }
  .transport-card h3{
    font-family:var(--serif);font-weight:500;font-size:22px;line-height:1.2;
    color:var(--petrol);letter-spacing:-0.008em;margin:0;
  }
  .transport-card p{
    font-family:var(--sans);font-size:15px;line-height:1.6;color:var(--tinte);margin:0;
  }
  .transport-card .lines{
    display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;
  }
  .transport-card .line{
    display:inline-block;padding:4px 10px;
    font-family:var(--sans);font-weight:600;font-size:12.5px;
    letter-spacing:0.04em;
    background:var(--creme);border:1px solid var(--hairline);color:var(--petrol);
    border-radius:2px;
  }
  .transport-card .line.tram{background:#ffefd5;color:#7a5120;border-color:#e8d3a3;}
  .transport-card .line.bus{background:#e0ebe8;color:#0a3638;border-color:#b9d3cd;}

  @media (max-width:960px){
    .an-grid{grid-template-columns:1fr;gap:32px;}
    .transport-grid{grid-template-columns:1fr;gap:16px;}
    .an-main,.an-transport{padding:var(--space-section-sm) 0;}
  }
  @media (max-width:560px){
    .an-col .contact-row{grid-template-columns:1fr;}
  }
</style>

<main id="top">

<PageHero variant="page">
  <Fragment slot="eyebrow">{page.hero.eyebrow}</Fragment>
  <Fragment slot="title">{page.hero.title}</Fragment>
  <Fragment slot="lede">{page.hero.lede}</Fragment>
</PageHero>

<section class="an-main" aria-label="Adresse und Karte">
  <div class="container">
    <div class="an-grid">
      <div class="an-col">
        <h2>Adresse &amp; Kontakt</h2>
        <div class="address">
          <strong>{school.name}</strong>
          {school.address.street}<br>
          {school.address.postal} {school.address.city}<br><br>
          <a href={`tel:+49${school.phone.replace(/\D/g, "").replace(/^0/, "")}`}>Telefon · {school.phone}</a><br>
          <MailLink email={school.emailGeneral} />
        </div>
        <p style="font-family:var(--sans);font-size:14.5px;line-height:1.6;color:var(--stein);margin:24px 0 0;max-width:40ch;">
          {page.contactNote}
        </p>
      </div>
      <div class="an-col">
        <h2>{page.map.title}</h2>
        <div class="map-wrap">
          <div class="map-consent" id="mapConsent" data-src={page.map.embedSrc}>
            <p class="map-consent-text">
              Die Karte wird von <strong>OpenStreetMap</strong> geladen. Dabei wird Ihre IP-Adresse an die OpenStreetMap&nbsp;Foundation (UK) übermittelt. Erst nach Ihrer Zustimmung wird die Karte geladen.
            </p>
            <button type="button" class="map-consent-btn" id="mapConsentBtn">Karte laden</button>
            <p class="map-consent-note">Details in unserer <a href="Datenschutz.html">Datenschutzerklärung</a>.</p>
          </div>
        </div>
        <a class="map-link" href={page.map.externalUrl} target="_blank" rel="noopener">
          Auf OpenStreetMap öffnen <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<section class="an-transport" aria-label="So kommen Sie zu uns">
  <div class="container">
    <div class="head">
      <span class="eyebrow">{page.transport.eyebrow}</span>
      <h2>{page.transport.title}</h2>
    </div>
    <div class="transport-grid">
      {page.transport.cards.map((card: any) => (
        <article class="transport-card">
          <span class="mode">{card.mode}</span>
          <h3 set:html={safeBreaks(card.title)} />
          <p>{card.body}</p>
          {card.lines && card.lines.length > 0 && (
            <div class="lines">
              {card.lines.map((line: any) => (
                <span class={`line ${line.type}`}>{line.label}</span>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function(){
    var box = document.getElementById('mapConsent');
    var btn = document.getElementById('mapConsentBtn');
    if (!box || !btn) return;
    btn.addEventListener('click', function(){
      var src = box.getAttribute('data-src');
      if (!src) return;
      var iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = 'UNESCO-Schule Essen auf OpenStreetMap';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox');
      box.replaceWith(iframe);
    });
  })();
</script>

</main>
</BaseLayout>
