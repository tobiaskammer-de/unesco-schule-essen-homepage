---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactCard from "../components/ContactCard.astro";
import { getSingle } from "../lib/pageContent";

const page: any = await getSingle("pageBerufsorientierung");
---
<BaseLayout title="Studien- und Berufsorientierung · UNESCO-Schule Essen">
<style is:global>
  /* ---------- Berufsorientierung ---------- */
  .bo-intro{background:var(--creme);padding:var(--space-section) 0;}
  .bo-intro-grid{
    display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);
    gap:56px;align-items:start;
  }
  .bo-intro h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.4vw,44px);line-height:1.1;
    color:var(--petrol);letter-spacing:-0.015em;margin:0;
  }
  .bo-intro p{
    font-family:var(--sans);font-size:17px;line-height:1.7;color:var(--tinte);
    margin:0 0 16px;
  }
  .bo-intro p em{font-style:italic;color:var(--bordeaux);}

  /* Stufen — Sek I & Sek II */
  .bo-stufen{background:var(--creme);padding:var(--space-section) 0;}
  .bo-stufen .head{max-width:820px;margin:0 0 48px;}
  .bo-stufen .head .eyebrow{display:block;margin-bottom:14px;}
  .bo-stufen .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.2vw,44px);line-height:1.15;letter-spacing:-0.015em;
    color:var(--petrol);margin:0 0 16px;
  }
  .bo-stufen .head p{
    font-family:var(--sans);font-size:17px;line-height:1.65;color:var(--stein);
    max-width:680px;margin:0;
  }
  .bo-stufen-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px;}
  .bo-stufe{
    background:#fff;border:1px solid var(--hairline);
    border-top:var(--card-accent-width) solid var(--petrol);
    padding:36px 36px 32px;display:flex;flex-direction:column;gap:18px;
  }
  .bo-stufe .label{
    font-family:var(--sans);font-size:11px;font-weight:600;
    letter-spacing:0.16em;text-transform:uppercase;color:var(--petrol);
  }
  .bo-stufe h3{
    font-family:var(--serif);font-weight:500;font-size:24px;line-height:1.2;
    color:var(--petrol);letter-spacing:-0.008em;margin:0;
  }
  .bo-stufe .when{
    font-family:var(--serif);font-style:italic;font-size:15px;color:var(--stein);
    margin:0;
  }
  .bo-stufe ul{list-style:none;margin:0;padding:0;}
  .bo-stufe ul li{
    position:relative;padding:10px 0 10px 22px;
    font-family:var(--sans);font-size:15px;line-height:1.55;color:var(--tinte);
    border-bottom:1px solid var(--hairline);
  }
  .bo-stufe ul li:first-child{border-top:1px solid var(--hairline);}
  .bo-stufe ul li::before{
    content:"";position:absolute;left:0;top:18px;
    width:12px;height:1px;background:var(--petrol);
  }
  .bo-stufe ul li strong{color:var(--petrol);font-weight:500;}

  /* Beratungsangebot — quick nav */
  .bo-angebot{background:var(--offwhite);padding:var(--space-section) 0;border-top:1px solid var(--hairline);}
  .bo-angebot .head{max-width:820px;margin:0 0 48px;}
  .bo-angebot .head .eyebrow{display:block;margin-bottom:14px;}
  .bo-angebot .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(28px,3vw,40px);line-height:1.15;letter-spacing:-0.015em;
    color:var(--petrol);margin:0;
  }
  .bo-angebot-grid{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;
  }
  .bo-angebot-card{
    background:#fff;border:1px solid var(--hairline);
    border-top:var(--card-accent-width) solid var(--petrol);
    padding:28px 28px;
    display:flex;flex-direction:column;gap:10px;
    text-decoration:none;color:inherit;
    transition:transform var(--transition), box-shadow var(--transition);
  }
  .bo-angebot-card:hover{transform:translateY(-2px);box-shadow:0 14px 34px -22px rgba(14,77,79,0.28);}
  @media (prefers-reduced-motion: reduce){.bo-angebot-card:hover{transform:none;}}
  /* Statische Karte ohne Link/Hover */
  .bo-angebot-card--static{cursor:default;transition:none;}
  .bo-angebot-card--static:hover{transform:none;box-shadow:none;}
  .bo-angebot-card .label{
    font-family:var(--sans);font-size:11px;font-weight:600;
    letter-spacing:0.14em;text-transform:uppercase;color:var(--petrol);
  }
  .bo-angebot-card h3{
    font-family:var(--serif);font-weight:500;font-size:20px;line-height:1.2;
    color:var(--petrol);letter-spacing:-0.008em;margin:0;
  }
  .bo-angebot-card p{
    font-family:var(--sans);font-size:14.5px;line-height:1.6;color:var(--stein);margin:0;flex:1;
  }
  .bo-angebot-card .go{
    align-self:flex-start;margin-top:6px;
    font-family:var(--sans);font-size:13.5px;font-weight:500;color:var(--bordeaux);
    border-bottom:1px solid currentColor;padding-bottom:2px;
  }

  /* Beratungs-Sektionen (Falk, Talentscout): gemeinsames Layout */
  .bo-falk,
  .bo-talent{
    padding:var(--space-section) 0;border-top:1px solid var(--hairline);
    scroll-margin-top:120px;
  }
  .bo-falk{background:var(--creme);}
  .bo-talent{background:var(--offwhite);}
  .bo-falk .head,
  .bo-talent .head{max-width:820px;margin:0 0 40px;}
  .bo-falk .head .eyebrow,
  .bo-talent .head .eyebrow{display:block;margin-bottom:14px;}
  .bo-falk .head h2,
  .bo-talent .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.4vw,48px);line-height:1.1;letter-spacing:-0.015em;
    color:var(--petrol);margin:0 0 16px;
  }
  .bo-falk .head h2 em,
  .bo-talent .head h2 em{font-style:italic;color:var(--bordeaux);}
  .bo-falk .head .lede,
  .bo-talent .head .lede{
    font-family:var(--sans);font-size:17px;line-height:1.65;color:var(--stein);
    max-width:720px;margin:0;
  }
  .bo-qa-grid{
    display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);
    gap:48px;align-items:start;
  }
  .bo-qa-list{
    list-style:none;margin:0;padding:0;
    display:grid;grid-template-columns:1fr;gap:2px;
    background:var(--hairline);border:1px solid var(--hairline);
  }
  .bo-qa-list li{
    background:#fff;padding:22px 26px;
    display:grid;grid-template-columns:minmax(0,160px) minmax(0,1fr);gap:22px;align-items:baseline;
  }
  .bo-qa-list .q{
    font-family:var(--sans);font-size:11.5px;font-weight:600;
    letter-spacing:0.14em;text-transform:uppercase;color:var(--petrol);
  }
  .bo-qa-list .a{
    font-family:var(--sans);font-size:15.5px;line-height:1.65;color:var(--tinte);
  }

  /* Personen-Karte für Falk Lindemann (kompakt, kleines Foto). */
  .bo-falk-card{
    background:#fff;border:1px solid var(--hairline);
    border-top:var(--card-accent-width) solid var(--petrol);
    padding:32px 32px 28px;
    display:flex;flex-direction:column;gap:14px;align-items:flex-start;
  }
  .bo-falk-card .photo{
    width:84px;height:84px;border-radius:50%;overflow:hidden;background:var(--petrol);
    flex-shrink:0;
  }
  .bo-falk-card .photo img{width:100%;height:100%;object-fit:cover;display:block;}
  .bo-falk-card .role{
    font-family:var(--sans);font-size:11px;font-weight:600;
    letter-spacing:0.14em;text-transform:uppercase;color:var(--bordeaux);margin:0;
  }
  .bo-falk-card .name{
    font-family:var(--serif);font-weight:500;font-size:24px;line-height:1.15;
    color:var(--petrol);letter-spacing:-0.01em;margin:0;
  }
  .bo-falk-card .sub{
    font-family:var(--sans);font-size:14.5px;color:var(--stein);margin:0;
  }
  .bo-falk-card .cta{
    display:inline-flex;align-items:center;gap:6px;
    margin-top:6px;padding:11px 18px;
    background:var(--petrol);color:var(--creme);
    font-family:var(--sans);font-weight:500;font-size:14px;
    border:1.5px solid var(--petrol);
    transition:background var(--transition-fast);white-space:nowrap;
  }
  .bo-falk-card .cta:hover{background:var(--petrol-dark);color:var(--creme);}

  /* Ansprechpartner */
  .bo-contacts{background:var(--creme);padding:var(--space-section) 0;border-top:1px solid var(--hairline);}
  .bo-contacts .head{max-width:820px;margin:0 0 40px;}
  .bo-contacts .head .eyebrow{display:block;margin-bottom:14px;}
  .bo-contacts .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(28px,3vw,40px);line-height:1.15;letter-spacing:-0.015em;
    color:var(--petrol);margin:0;
  }
  .bo-contacts-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;}
  .bo-contact{
    background:#fff;border:1px solid var(--hairline);
    border-top:var(--card-accent-width) solid var(--petrol);
    padding:28px 32px;
    display:grid;grid-template-columns:72px 1fr;gap:20px;align-items:center;
  }
  .bo-contact .avatar{
    width:72px;height:72px;border-radius:50%;background:var(--petrol);
    display:flex;align-items:center;justify-content:center;
    font-family:var(--serif);font-weight:500;font-size:26px;color:var(--creme);
    letter-spacing:-0.01em;
  }
  .bo-contact .info .role{
    font-family:var(--sans);font-size:11px;font-weight:600;
    letter-spacing:0.14em;text-transform:uppercase;color:var(--petrol);margin-bottom:4px;
  }
  .bo-contact .info .name{
    font-family:var(--serif);font-weight:500;font-size:20px;color:var(--petrol);
    letter-spacing:-0.008em;margin:0 0 4px;
  }
  .bo-contact .info .sub{
    font-family:var(--sans);font-size:14px;color:var(--stein);margin:0;
  }

  /* Tablet-Zwischenlayout: Contact-Card darf unter den Body rutschen,
     damit die Mittelspalte mehr Raum für den Text bekommt. */
  @media (max-width:1080px) and (min-width:961px){
    .bo-lauf .inner{
      grid-template-columns:minmax(0,120px) minmax(0,1fr);
      grid-template-areas:"icon body" "contact contact";
      gap:24px 28px;padding:28px 32px;
    }
    .bo-lauf .icon{grid-area:icon;width:72px;height:72px;font-size:32px;}
    .bo-lauf .body{grid-area:body;}
    .bo-lauf .contact{grid-area:contact;}
  }

  /* Tablet-Zwischenlayout für Beratungs-Sektionen: Personen-Card rutscht unter
     die Q&A-Liste, damit die Tabelle volle Breite bekommt. */
  @media (max-width:1080px) and (min-width:961px){
    .bo-qa-grid{grid-template-columns:1fr;gap:28px;}
    .bo-qa-list li{grid-template-columns:minmax(0,130px) minmax(0,1fr);}
  }

  @media (max-width:960px){
    .bo-intro-grid{grid-template-columns:1fr;gap:28px;}
    .bo-lauf .inner{grid-template-columns:1fr;gap:18px;padding:24px 24px;}
    .bo-lauf .icon{width:64px;height:64px;font-size:28px;}
    .bo-stufen-grid{grid-template-columns:1fr;gap:18px;}
    .bo-angebot-grid{grid-template-columns:1fr;gap:14px;}
    .bo-qa-grid{grid-template-columns:1fr;gap:24px;}
    .bo-qa-list li{grid-template-columns:1fr;gap:4px;}
    .bo-contacts-grid{grid-template-columns:1fr;gap:14px;}
    .bo-intro,.bo-lauf,.bo-stufen,.bo-angebot,.bo-falk,.bo-talent,.bo-contacts{padding:var(--space-section-sm) 0;}
  }
</style>

<main id="top">

<PageHero variant="feature" image="assets/hero/berufsorientierung.jpg" imageAlt="Junge Menschen arbeiten gemeinsam am Laptop">
  <Fragment slot="eyebrow">{page.hero.eyebrow}</Fragment>
  <Fragment slot="title">{page.hero.title}{page.hero.titleHighlight && <><br /><em>{page.hero.titleHighlight}</em></>}</Fragment>
  <Fragment slot="lede">{page.hero.lede}</Fragment>
</PageHero>

<section class="bo-intro" aria-label="Einordnung">
  <div class="container">
    <div class="bo-intro-grid">
      <div>
        <h2>Der Weg entsteht <em>beim Gehen</em></h2>
      </div>
      <div>
        <p>Zwischen Grundschule und Universität liegt ein Bildungsweg voller Regeln, Vorgaben und Entscheidungen. Für Schülerinnen, Schüler und Eltern ist es oft schwierig, dabei den Überblick zu behalten, zumal Bildungswege nicht immer geradlinig verlaufen.</p>
        <p>Deshalb begleiten wir systematisch: mit altersgerechten Angeboten in den Klassen&nbsp;8 bis 10, intensiver Orientierung in der Oberstufe und persönlicher Laufbahnberatung, wann immer sie gebraucht wird.</p>
      </div>
    </div>
  </div>
</section>

<section class="bo-stufen" aria-label="Angebote in Sek I und Sek II">
  <div class="container">
    <div class="head">
      <span class="eyebrow">Was wann passiert</span>
      <h2>Orientierung in Sek&nbsp;I und Sek&nbsp;II</h2>
    </div>

    <div class="bo-stufen-grid">
      <article class="bo-stufe">
        <span class="label">Sekundarstufe&nbsp;I</span>
        <h3>Potenziale erkennen</h3>
        <p class="when">Klassen 8 bis 10</p>
        <ul>
          <li><strong>Klasse 8:</strong> Online-Tool BOaktiv (ab Schuljahr 2026/27).</li>
          <li><strong>Klasse 9:</strong> Potenzialanalyse (Einstiegsinstrument), Berufsfelderkundungen (3 Tage in Betrieben), Schülerbetriebspraktikum (2 Wochen), Planspiel „Spiel des Lebens" und Anschlussvereinbarung.</li>
          <li><strong>Klasse 10:</strong> Beratungstermine für Schulabgängerinnen und Schulabgänger mit der Arbeitsagentur Essen; IHK-Kooperation „Auszubildende als Werbebotschafter".</li>
          <li><strong>Alle Klassen:</strong> Girls' und Boys' Day.</li>
          <li><strong>Kooperation:</strong> Kreishandwerkerschaft Essen, Angebote für die Klasse 9 und die IVK.</li>
        </ul>
      </article>

      <article class="bo-stufe">
        <span class="label">Sekundarstufe&nbsp;II</span>
        <h3>Konkret werden</h3>
        <p class="when">EF · Q1 · Q2</p>
        <ul>
          <li><strong>EF:</strong> Zweiwöchiges Pflichtpraktikum.</li>
          <li><strong>Q1:</strong> Teilnahme an der Ausbildungsoffensive.</li>
          <li><strong>Q2:</strong> Besuch von Ausbildungs- und Studienmessen.</li>
          <li><strong>Beratung:</strong> Anschlussvereinbarung; wöchentliche Beratungsangebote der Jugendberufsagentur (JBA).</li>
          <li><strong>Begabtenförderung &amp; Studienorientierung:</strong> Talentscouting der Universität Duisburg-Essen.</li>
        </ul>
      </article>
    </div>
  </div>
</section>

<section class="bo-angebot" aria-label="Beratungsangebot im Überblick">
  <div class="container">
    <div class="head">
      <span class="eyebrow">Beratungsangebot</span>
      <h2>Wer berät zu welchem Thema?</h2>
    </div>
    <div class="bo-angebot-grid">
      <a href="Oberstufe.html#laufbahn" class="bo-angebot-card">
        <span class="label">Schullaufbahn</span>
        <h3>Individuelle Laufbahnberatung</h3>
        <p>Wege durch das Schulsystem, Fächerwahl, Übergänge, Wiederholung oder Wechsel: persönliche Orientierung, wenn Entscheidungen anstehen.</p>
        <span class="go">Zur Laufbahnberatung →</span>
      </a>
      <a href="#falk-lindemann" class="bo-angebot-card">
        <span class="label">Studium &amp; Beruf</span>
        <h3>Studien- und Berufsberatung</h3>
        <p>Falk Lindemann, Studien- und Berufsberater, begleitet bei Studienwahl, Bewerbung und Übergängen. Sein TaskCards-Board bündelt aktuelle Termine und Hilfen für Schülerinnen und Schüler.</p>
        <span class="go">Zu Falk Lindemann →</span>
      </a>
      <a href="#talentscout" class="bo-angebot-card">
        <span class="label">Uni-Übergang</span>
        <h3>Frau Schröter</h3>
        <p>Sarah Schröter von der Universität Duisburg-Essen begleitet besonders Jugendliche ohne akademische Wurzeln auf dem Weg ins Studium: kostenfrei, vor Ort, langfristig.</p>
        <span class="go">Zum Talentscout →</span>
      </a>
      <a href="#friedland" class="bo-angebot-card">
        <span class="label">Übergang in den Beruf</span>
        <h3>Frau Friedland</h3>
        <p>Anni Friedland begleitet Schülerinnen und Schüler individuell beim Übergang von der Schule in eine Ausbildung.</p>
        <span class="go">Zur Berufseinstiegsbegleitung →</span>
      </a>
    </div>
  </div>
</section>

<section class="bo-falk" id="falk-lindemann" aria-label="Studien- und Berufsberatung Falk Lindemann">
  <div class="container">
    <div class="head">
      <span class="eyebrow">Studien- und Berufsberatung</span>
      <h2>Falk Lindemann</h2>
      <p class="lede">Studien- und Berufsberater an unserer Schule. Auf seinem TaskCards-Board sammelt er laufend Informationen für Schülerinnen und Schüler: von Studienwahl über Bewerbung bis hin zu aktuellen Terminen und Veranstaltungen.</p>
    </div>

    <div class="bo-qa-grid">
      <ul class="bo-qa-list">
        <li><span class="q">Für wen?</span><span class="a">Schülerinnen und Schüler aller Jahrgänge, die sich für Studium, Ausbildung oder duale Wege interessieren, auch bei Unsicherheit, was zu einem passt.</span></li>
        <li><span class="q">Was gibt's?</span><span class="a">Beratung zu Studien- und Berufswahl, Bewerbungsprozessen und Hilfen wie BAB, BAföG oder Stipendien. Hinweise auf Messen, Infotage und Tests.</span></li>
        <li><span class="q">Wie geht's?</span><span class="a">Die Anmeldung zum persönlichen Beratungsgespräch ist ganz einfach: Über den Link unten können sich Schülerinnen und Schüler jederzeit für einen Termin anmelden. Auf dem Info-Board finden sich außerdem zahlreiche Tipps, Infos und eine Übersicht der anstehenden Berufswahlevents.</span></li>
        <li><span class="q">Was kostet's?</span><span class="a">Nichts. Die Beratung ist für Schülerinnen und Schüler kostenfrei.</span></li>
      </ul>

      <article class="bo-falk-card">
        <div class="photo">
          <img src="assets/beratung/lindemann-falk.jpg" alt="Porträt Falk Lindemann" width="200" height="300" loading="lazy" />
        </div>
        <p class="role">Studien- und Berufsberater</p>
        <h3 class="name">Falk Lindemann</h3>
        <p class="sub">Terminanfrage über das Info-Board</p>
        <a class="cta" href="https://www.taskcards.de/#/board/415fc6c6-b78e-4c13-9896-637cbaf79189/view" target="_blank" rel="noopener noreferrer">Zum Info-Board →</a>
      </article>
    </div>
  </div>
</section>

<section class="bo-talent" id="talentscout" aria-label="Talentscout">
  <div class="container">
    <div class="head">
      <h2>Talentscout der Uni Duisburg-Essen</h2>
      <p class="lede">Ziel des NRW-Talentscoutings ist es, jungen Menschen gleiche Bildungschancen zu ermöglichen, unabhängig von Bildungshintergrund oder Einkommen der Eltern.</p>
    </div>

    <div class="bo-qa-grid">
      <ul class="bo-qa-list">
        <li><span class="q">Für wen?</span><span class="a">Insbesondere Jugendliche ohne akademische Wurzeln, die sich ein Studium zutrauen sollen: wir ermutigen und begleiten.</span></li>
        <li><span class="q">Was gibt's?</span><span class="a">Regelmäßige Beratungsgespräche vor Ort in der Schule. Orientierung beim Übergang von Schule zu Hochschule. Begleitung auch nach dem Abitur.</span></li>
        <li><span class="q">Von wem?</span><span class="a">Sarah Schröter, Talentscout der Universität Duisburg-Essen, regelmäßig bei uns im Haus und erreichbar über Frau Schulte-Ontrop.</span></li>
      </ul>

      <ContactCard
        roleLabel="Talentscout"
        manualName="Sarah Schröter"
        manualPhone="0201 · 280 26 30"
        manualPhoto="assets/beratung/schroeter-sarah.png"
        subline="Universität Duisburg-Essen · NRW-Talentscouting"
        room="Regelmäßig vor Ort · Termine über Frau Schulte-Ontrop"
        ctaLabel="Termin über Frau Schulte-Ontrop"
        variant="compact"
      />
    </div>
  </div>
</section>

<section class="bo-talent" id="friedland" aria-label="Berufseinstiegsbegleitung Anni Friedland">
  <div class="container">
    <div class="head">
      <h2>Berufseinstiegsbegleitung</h2>
      <p class="lede">Die Berufseinstiegsbegleitung (BerEb) unterstützt Schülerinnen und Schüler individuell beim Übergang von der Schule in eine Ausbildung.</p>
    </div>

    <div class="bo-qa-grid">
      <ul class="bo-qa-list">
        <li><span class="q">Für wen?</span><span class="a">Schülerinnen und Schüler ab Klasse 9, die beim Schritt in Ausbildung oder Beruf zusätzliche Begleitung gut gebrauchen können.</span></li>
        <li><span class="q">Was gibt's?</span><span class="a">Individuelle Beratung und Unterstützung: von Bewerbung und Praktikumssuche bis hin zur Stabilisierung in den ersten Ausbildungsmonaten.</span></li>
        <li><span class="q">Wo?</span><span class="a">Raum „Bob", direkt unter dem Selbstlernzentrum.</span></li>
      </ul>

      <ContactCard
        roleLabel="Berufseinstiegsbegleitung"
        manualName="Anni Friedland"
        room="Raum Bob · direkt unter dem Selbstlernzentrum"
        variant="compact"
      />
    </div>
  </div>
</section>

<section class="bo-contacts" aria-label="Weitere Ansprechpersonen">
  <div class="container">
    <div class="head">
