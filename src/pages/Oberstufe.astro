---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import MailLink from "../components/MailLink.astro";
import { getTeacherByRole, ROLES } from "../lib/roles";
import { displayName } from "../lib/teachers";
import { getSingle } from "../lib/pageContent";
import { safeBold } from "../lib/safeMarkup";

const page: any = await getSingle("pageOberstufe");

const [koordOberstufe, stufeEF] = await Promise.all([
  getTeacherByRole(ROLES.KOORD_OBERSTUFE),
  getTeacherByRole(ROLES.STUFENLEITUNG_EF),
]);
---
<BaseLayout title="Oberstufe (EF · Q1 · Q2) · UNESCO-Schule Essen" description="Die gymnasiale Oberstufe der UNESCO-Schule Essen: Leistungs- und Grundkurse, Studienorientierung und Beratung auf dem Weg zum Abitur.">
<style is:global>
  /* ---------- Oberstufe ---------- */
  /* Laufbahn (Callout) — verschoben aus Berufsorientierung */
  .ob-lauf{background:var(--offwhite);padding:var(--space-section-sm) 0;border-bottom:1px solid var(--hairline);}
  .ob-lauf .inner{
    background:#fff;border:1px solid var(--hairline);
    border-left:var(--card-accent-width) solid var(--petrol);
    display:grid;grid-template-columns:minmax(0,140px) minmax(0,1fr) minmax(0,260px);
    gap:36px;align-items:center;padding:32px 40px;
  }
  .ob-lauf .icon{
    width:88px;height:88px;border-radius:50%;
    background:rgba(14,77,79,0.08);color:var(--petrol);
    display:flex;align-items:center;justify-content:center;
    font-family:var(--serif);font-weight:500;font-size:38px;
  }
  .ob-lauf .body .kicker{
    font-family:var(--sans);font-size:11px;font-weight:600;
    letter-spacing:0.14em;text-transform:uppercase;color:var(--petrol);
  }
  .ob-lauf .body h3{
    font-family:var(--serif);font-weight:500;font-size:clamp(24px,2.6vw,32px);
    line-height:1.2;color:var(--petrol);letter-spacing:-0.01em;margin:8px 0 10px;
  }
  .ob-lauf .body p{
    font-family:var(--sans);font-size:16px;line-height:1.65;color:var(--tinte);margin:0;
  }
  .ob-lauf .contact{
    font-family:var(--sans);font-size:14.5px;line-height:1.55;
    color:var(--stein);
    padding:18px 20px;background:var(--creme);border:1px solid var(--hairline);
  }
  .ob-lauf .contact .role{
    font-size:11px;font-weight:600;letter-spacing:0.14em;
    text-transform:uppercase;color:var(--bordeaux);margin-bottom:6px;
  }
  .ob-lauf .contact .name{
    font-family:var(--serif);font-weight:500;font-size:18px;color:var(--petrol);
    margin:0 0 4px;
  }
  .ob-lauf .contact .room{color:var(--stein);}
  @media (max-width:960px){
    .ob-lauf .inner{grid-template-columns:1fr;gap:20px;padding:28px 24px;}
    .ob-lauf .icon{margin:0 auto;}
  }

  .ob-download{
    display:inline-flex;align-items:center;gap:12px;
    padding:14px 22px;border-radius:4px;
    background:var(--gold);color:var(--gold-text);
    font-family:var(--sans);font-size:15px;font-weight:600;text-decoration:none;
    transition:background var(--transition-fast), transform var(--transition-fast);
  }
  .ob-download:hover{background:var(--gold-hover);transform:translateY(-1px);color:var(--gold-text);}
  @media (prefers-reduced-motion: reduce){.ob-download:hover{transform:none;}}
  .ob-download .icon{width:18px;height:18px;fill:currentColor;}
  .ob-download .meta{
    font-family:var(--sans);font-size:12px;font-weight:500;color:#5e3f12;letter-spacing:0.04em;
  }

  /* DU/WIR split */
  .ob-duwir{background:var(--creme);padding:var(--space-section) 0;}
  .duwir-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;}
  .duwir{padding:40px 36px;background:#fff;border:1px solid var(--hairline);}
  .duwir-du{border-top:4px solid var(--bordeaux);}
  .duwir-wir{border-top:4px solid var(--petrol);background:var(--petrol);color:var(--creme);border-color:var(--petrol);}
  .duwir .label{
    font-family:var(--serif);font-weight:500;font-size:48px;line-height:1;
    color:var(--bordeaux);letter-spacing:-0.02em;margin:0 0 6px;
  }
  .duwir-wir .label{color:var(--gold);}
  .duwir h3{
    font-family:var(--serif);font-weight:500;font-size:24px;line-height:1.2;
    color:var(--petrol);letter-spacing:-0.01em;margin:0 0 18px;
  }
  .duwir-wir h3{color:var(--creme);}
  .duwir ul{list-style:none;margin:0;padding:0;}
  .duwir li{
    position:relative;padding:10px 0 10px 22px;
    font-family:var(--sans);font-size:15.5px;line-height:1.6;color:var(--tinte);
    border-bottom:1px solid var(--hairline);
  }
  .duwir li::before{
    content:"";position:absolute;left:0;top:19px;width:12px;height:1px;background:var(--bordeaux);
  }
  .duwir li:last-child{border-bottom:0;}
  .duwir-wir li{color:rgba(245,239,231,0.92);border-bottom-color:rgba(245,239,231,0.16);}
  .duwir-wir li::before{background:var(--gold);}
  .duwir .oder{
    text-align:center;padding:18px 0;
    font-family:var(--serif);font-style:italic;font-size:22px;color:var(--stein);
  }
  .duwir-wir .oder{color:rgba(245,239,231,0.7);}

  /* Stats band */
  .ob-stats{background:var(--offwhite);padding:var(--space-section-sm) 0;}
  .stats-row{
    display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;
    border:1px solid var(--hairline);
  }
  .ob-stat{
    padding:28px 24px;border-right:1px solid var(--hairline);
    display:flex;flex-direction:column;gap:6px;
  }
  .ob-stat:last-child{border-right:0;}
  .ob-stat .n{
    font-family:var(--serif);font-weight:500;font-size:clamp(32px,3.4vw,44px);line-height:1;
    color:var(--petrol);letter-spacing:-0.02em;
    font-variant-numeric:tabular-nums;
  }
  .ob-stat .label{
    font-family:var(--sans);font-size:12.5px;color:var(--stein);line-height:1.5;
    letter-spacing:0.02em;
  }

  /* Generic section pattern */
  .ob-sect{padding:var(--space-section) 0;border-top:1px solid var(--hairline);}
  .ob-sect.alt{background:var(--creme);}
  .ob-sect .head{max-width:780px;margin:0 0 40px;}
  .ob-sect .head .eyebrow{display:block;margin-bottom:14px;}
  .ob-sect .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(28px,3vw,40px);line-height:1.15;letter-spacing:-0.015em;
    color:var(--petrol);margin:0 0 12px;
  }
  .ob-sect .head p{
    font-family:var(--sans);font-size:16.5px;line-height:1.65;color:var(--stein);margin:0;
  }
  .ob-check{
    list-style:none;margin:0;padding:0;
    display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2px 32px;
    border-top:1px solid var(--hairline);
  }
  .ob-check li{
    padding:16px 0 16px 28px;border-bottom:1px solid var(--hairline);
    position:relative;
    font-family:var(--sans);font-size:15.5px;line-height:1.55;color:var(--tinte);
  }
  .ob-check li::before{
    content:"✓";position:absolute;left:0;top:16px;
    color:var(--sage);font-weight:600;font-size:16px;
  }
  .ob-check li strong{color:var(--petrol);}

  /* Neu ab 2027/28 */
  .ob-neu-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;}
  .ob-neu-card{
    background:#fff;border:1px solid var(--hairline);
    border-top:var(--card-accent-width) solid var(--bordeaux);
    padding:28px 28px 26px;
  }
  .ob-neu-card h3{
    font-family:var(--serif);font-weight:500;font-size:22px;line-height:1.2;
    color:var(--petrol);letter-spacing:-0.008em;margin:0 0 10px;
  }
  .ob-neu-card p{
    font-family:var(--sans);font-size:15.5px;line-height:1.6;color:var(--tinte);margin:0;
  }
  .ob-neu-detail{max-width:780px;margin:36px 0 0;}
  .ob-neu-detail p{
    font-family:var(--sans);font-size:16px;line-height:1.65;color:var(--tinte);margin:0 0 14px;
  }
  .ob-neu-detail p strong{color:var(--petrol);}
  .ob-neu-detail p.fine{font-size:13px;line-height:1.55;color:var(--stein);margin:20px 0 0;}
  @media (max-width:960px){.ob-neu-grid{grid-template-columns:1fr;gap:14px;}}

  /* Six steps */
  .ob-steps{background:var(--petrol);color:var(--creme);padding:var(--space-section) 0;}
  .ob-steps .head{max-width:780px;margin:0 0 48px;}
  .ob-steps .head .eyebrow{color:var(--gold);display:block;margin-bottom:14px;}
  .ob-steps .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(32px,3.6vw,48px);line-height:1.12;letter-spacing:-0.015em;
    color:var(--creme);margin:0;
  }
  .steps-list{
    list-style:none;margin:0;padding:0;
    display:flex;flex-direction:column;gap:2px;
    background:rgba(245,239,231,0.15);
    border:1px solid rgba(245,239,231,0.15);
  }
  .steps-list li{
    background:var(--petrol);padding:26px 32px;
    display:grid;grid-template-columns:72px 1fr auto;gap:28px;align-items:center;
  }
  .steps-list .num{
    font-family:var(--serif);font-weight:500;font-size:40px;line-height:1;
    color:var(--gold);letter-spacing:-0.025em;
  }
  .steps-list .body h3{
    font-family:var(--serif);font-weight:500;font-size:22px;line-height:1.2;
    color:var(--creme);letter-spacing:-0.008em;margin:0 0 4px;
  }
  .steps-list .body p{
    font-family:var(--sans);font-size:14.5px;line-height:1.55;
    color:rgba(245,239,231,0.82);margin:0;
  }
  .steps-list .when{
    font-family:var(--sans);font-size:12.5px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;
    color:var(--gold);text-align:right;min-width:140px;max-width:200px;
  }

  /* Contact */
  .ob-contact{background:var(--offwhite);padding:var(--space-section) 0;}
  .contact-duo{display:grid;grid-template-columns:1fr 1fr;gap:28px;}
  .contact-person{
    padding:32px 32px 30px;background:#fff;border:1px solid var(--hairline);
    display:flex;flex-direction:column;gap:8px;
  }
  .contact-person{
    border-top:var(--card-accent-width) solid var(--petrol);
  }
  .contact-person .role{
    font-family:var(--sans);font-size:11px;font-weight:600;
    letter-spacing:0.14em;text-transform:uppercase;color:var(--petrol);
  }
  .contact-person .name{
    font-family:var(--serif);font-weight:500;font-size:24px;line-height:1.2;
    color:var(--petrol);margin:2px 0;
  }
  .contact-person .title{
    font-family:var(--sans);font-size:14.5px;color:var(--stein);margin-bottom:8px;
  }
  .contact-person a{
    font-family:var(--sans);font-size:15px;color:var(--petrol);display:block;padding:2px 0;
  }
  .contact-person a:hover{text-decoration:underline;}


  .ob-welcome{
    position:relative;padding:var(--space-section-lg) 0;isolation:isolate;overflow:hidden;
  }
  .ob-welcome::before{
    content:"";position:absolute;inset:0;z-index:-2;
    background:url("/assets/sp-persoenlich.jpg") center 35%/cover no-repeat;
  }
  .ob-welcome::after{
    content:"";position:absolute;inset:0;z-index:-1;
    background:linear-gradient(180deg, rgba(14,77,79,0.82) 0%, rgba(14,77,79,0.92) 100%);
  }
  .ob-welcome .container{max-width:880px;text-align:center;color:var(--creme);}
  .ob-welcome .eyebrow{color:var(--gold);display:block;margin-bottom:16px;}
  .ob-welcome h2{
    font-family:var(--serif);font-weight:500;font-style:italic;
    font-size:clamp(32px,3.6vw,52px);line-height:1.15;
    color:var(--creme);letter-spacing:-0.015em;margin:0 0 20px;
  }
  .ob-welcome p{
    font-family:var(--sans);font-size:17px;line-height:1.65;
    color:rgba(245,239,231,0.9);max-width:620px;margin:0 auto;
  }
  .ob-welcome .cred{
    position:absolute;bottom:16px;left:32px;
    padding:5px 10px;background:rgba(14,77,79,0.78);
    color:rgba(255,255,255,0.95);
    font-family:var(--sans);font-size:10px;font-weight:500;
    letter-spacing:0.12em;text-transform:uppercase;border-radius:2px;
  }
  @media (max-width:780px){.ob-welcome{padding:72px 0;}}

  @media (max-width:960px){
    .duwir-grid{grid-template-columns:1fr;gap:18px;}
    .stats-row{grid-template-columns:1fr 1fr;}
    .ob-stat:nth-child(2){border-right:0;}
    .ob-stat:nth-child(-n+2){border-bottom:1px solid var(--hairline);}
    .ob-check{grid-template-columns:1fr;}
    .steps-list li{grid-template-columns:48px 1fr;gap:16px;padding:20px 24px;}
    .steps-list .when{grid-column:1 / -1;text-align:left;margin-top:6px;max-width:none;}
    .steps-list .num{font-size:30px;}
    .contact-duo{grid-template-columns:1fr;gap:14px;}
    .ob-duwir,.ob-sect,.ob-steps,.ob-contact{padding:var(--space-section-sm) 0;}
  }

  /* ---------- Photo placeholders (to be replaced by real photos) ---------- */
  .photo{position:relative;overflow:hidden;background:var(--creme);border-radius:2px;}
  .photo > img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease;}
  .photo .cred{
    position:absolute;bottom:10px;left:12px;
    padding:5px 10px;background:rgba(14,77,79,0.78);
    color:rgba(255,255,255,0.95);
    font-family:var(--sans);font-size:10px;font-weight:500;
    letter-spacing:0.12em;text-transform:uppercase;border-radius:2px;
    backdrop-filter:blur(4px);
  }
</style>

<main id="top">

<PageHero variant="feature" image="assets/hero/oberstufe.jpg" imageAlt="Schülerinnen und Schüler der Oberstufe bei der Gruppenarbeit">
  <Fragment slot="eyebrow">{page.hero.eyebrow}</Fragment>
  <Fragment slot="title">{page.hero.title}{page.hero.titleHighlight && <><br /><em>{page.hero.titleHighlight}</em></>}</Fragment>
  <Fragment slot="lede">{page.hero.lede}</Fragment>
  {/* Handbuch EF 2027/28: überarbeitete Fassung der Oberstufenkoordination (Wilbat, 12.11.2026). */}
  <Fragment slot="actions">
    <a href="/assets/Handbuch_EF_2027-28_UNESCO-Schule_Essen.pdf" class="ob-download" download>
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Handbuch zur Einführungsphase 2027/28
      <span class="meta">PDF · 0,4&#8239;MB</span>
    </a>
  </Fragment>
</PageHero>

<section class="ob-lauf" id="laufbahn" aria-label="Individuelle Laufbahnberatung">
  <div class="container">
    <div class="inner">
      <div class="icon" aria-hidden="true">i</div>
      <div class="body">
        <span class="kicker">Wenn's individuell wird</span>
        <h3>Individuelle Laufbahnberatung</h3>
        <p>Der Weg von der Grundschule in die Universität ist von zahlreichen Gesetzen und Vorgaben geregelt. Für Schülerinnen, Schüler und Eltern ist es oft schwierig, einen Überblick über alle Regelungen zu erhalten und die bestmöglichen Optionen zu wählen. Hier hilft persönliche Beratung, auch wenn der Weg einmal nicht idealtypisch verläuft.</p>
      </div>
      <aside class="contact">
        <div class="role">Ansprechpartner</div>
        <p class="name">{koordOberstufe ? displayName(koordOberstufe) : "Über das Sekretariat"}</p>
        <p class="room">Oberstufenbüro · Raum 104</p>
        {koordOberstufe && (
          <p class="room"><MailLink email={koordOberstufe.data.email} /></p>
        )}
      </aside>
    </div>
  </div>
</section>

<section class="ob-duwir" aria-label="Für wen ist die Oberstufe gedacht">
  <div class="container">
    <div class="duwir-grid">
      <article class="duwir duwir-du">
        <span class="label">DU</span>
        <ul>
          <li>besuchst zurzeit die 10. Klasse einer <strong>Realschule</strong>, <strong>Sekundarschule</strong>, <strong>Hauptschule</strong> oder eines <strong>Berufskollegs</strong> und machst am Ende dieses Schuljahres deine <strong>Fachoberschulreife mit Qualifikation</strong> zum Besuch der gymnasialen Oberstufe</li>
          <li>überlegst dir, weiter zur Schule zu gehen und ein <strong>Abitur</strong> oder die <strong>Fachhochschulreife</strong> zu erlangen, um zu studieren oder einen Beruf zu ergreifen</li>
        </ul>
        <div class="oder">oder</div>
        <ul>
          <li>möchtest an einer anderen Schule deine Schullaufbahn in der <strong>gymnasialen Oberstufe</strong> fortsetzen</li>
        </ul>
      </article>
      <article class="duwir duwir-wir">
        <span class="label">WIR</span>
        <ul>
          <li>sind ein Gymnasium mit <strong>jahrzehntelanger Erfahrung</strong> mit Schulwechslerinnen und Schulwechslern</li>
          <li>haben unsere gymnasiale Oberstufe gezielt auf Schülerinnen und Schüler ausgerichtet, die bis Klasse 10 <strong>eine andere Schulform</strong> besucht haben</li>
          <li>sind eine Schule, die dich <strong>intensiv begleitet</strong>, deinen eigenen Weg zu finden</li>
          <li>bilden in der EF <strong>Klassenverbände</strong> in Deutsch, Mathematik, Englisch und Sport, als weicher Übergang in den Kurs­betrieb</li>
        </ul>
      </article>
    </div>
  </div>
</section>

<section class="ob-stats" aria-label="Die Schule in Zahlen">
  <div class="container">
    <div class="stats-row">
      <div class="ob-stat"><span class="n">400</span><span class="label">Schülerinnen und Schüler aus fast 45 Nationen</span></div>
      <div class="ob-stat"><span class="n">250</span><span class="label">Schülerinnen und Schüler in der Oberstufe</span></div>
      <div class="ob-stat"><span class="n">48</span><span class="label">Lehrerinnen und Lehrer</span></div>
      <div class="ob-stat"><span class="n">iPad</span><span class="label">für alle Schülerinnen und Schüler</span></div>
    </div>
  </div>
</section>

<section class="ob-sect alt" id="neu" aria-label="Neu ab dem Schuljahr 2027/28">
  <div class="container">
    <div class="head">
      <span class="eyebrow">Neu ab 2027/28</span>
      <h2>Du bist der erste Jahrgang der neuen Oberstufe</h2>
    </div>
    <div class="ob-neu-grid">
      <article class="ob-neu-card">
        <h3>GKL statt Klausur</h3>
        <p>In jedem der drei Aufgabenfelder ersetzt ein gleichwertiger komplexer Leistungsnachweis (GKL) eine Klausur, je nach Fach zum Beispiel eine Präsentation, ein Portfolio oder eine praktische Aufgabe.</p>
      </article>
      <article class="ob-neu-card">
        <h3>Projektkurse in der Q2</h3>
        <p>Spannende Projektkurse aus unterschiedlichen Aufgabenfeldern. Gewählt wird in der Q1.</p>
      </article>
      <article class="ob-neu-card">
        <h3>Fünf Abiturfächer</h3>
        <p>Schriftliche, mündliche und Präsentationsprüfungen im Abitur. Die Abiturfächer 3 bis 5 legst du zu Beginn der Q2 fest.</p>
      </article>
    </div>
    <div class="ob-neu-detail">
      <p>In der EF schreibst du Klausuren in Deutsch, Mathematik und deinen Fremdsprachen sowie in mindestens einer Gesellschaftswissenschaft und einer Naturwissenschaft. Ein <strong>GKL</strong> ist genauso anspruchsvoll wie eine Klausur, hat aber eine andere Form und kann auch in Gruppen erarbeitet werden.</p>
      <p>In jedem der drei Aufgabenfelder (Sprachen, Kunst und Musik · Gesellschaftswissenschaften · Mathematik und Naturwissenschaften) erbringst du in der EF genau einen GKL, in einem Grundkurs, den du schriftlich belegt hast. In welchem Fach, entscheidest du selbst. Welche Formate es in welchem Fach gibt, legen die Kernlehrpläne und unsere Fachkonferenzen fest.</p>
      <p class="fine">Stand: November 2026. Rechtsgrundlage für die gymnasiale Oberstufe ist die APO-GOSt in der ab 01.08.2027 geltenden Fassung; rechtsverbindlich ist die in GV. NRW. bzw. BASS veröffentlichte Fassung.</p>
    </div>
  </div>
</section>

<section class="ob-sect" aria-label="Wir nehmen auf">
  <div class="container">
    <div class="head">
      <span class="eyebrow">Wer bei uns aufgenommen wird</span>
      <h2>Wir nehmen in die gymnasiale Oberstufe auf</h2>
      <p>Für die Aufnahme ist es unerheblich, welcher Notendurchschnitt dabei erreicht wurde: Was zählt, ist die erreichte Qualifikation. Alle Schülerinnen und Schüler erhalten bei uns die Chance auf den Erwerb der Allgemeinen Hochschulreife (Abitur) oder auf den Erwerb des schulischen Teils der Fachhochschulreife.</p>
    </div>
    <ul class="ob-check">
      <li>Schülerinnen und Schüler, die an einer <strong>Realschule, Sekundarschule, Hauptschule</strong> oder an einem <strong>Berufskolleg</strong> ihre Fachoberschulreife mit Qualifikationsvermerk erworben haben</li>
      <li>Schülerinnen und Schüler, die an einem <strong>anderen Gymnasium</strong> die Berechtigung zum Eintritt in die gymnasiale Oberstufe erworben haben oder die Jahrgangsstufe EF wiederholen</li>
      <li>Schülerinnen und Schüler, die an einem anderen Gymnasium am Ende des Schuljahres 2026/27 die Jahrgangsstufe <strong>EF wiederholen</strong> müssen oder möchten</li>
      <li>Schülerinnen und Schüler in die Jahrgangsstufen <strong>Q1 oder Q2</strong></li>
    </ul>
  </div>
</section>

<section class="ob-sect alt" aria-label="Wir bieten in der Oberstufe">
  <div class="container">
    <div class="head">
      <span class="eyebrow">Unser Angebot</span>
      <h2>Wir bieten in der Oberstufe</h2>
    </div>
    <ul class="ob-check">
      <li><strong>Klassenverband</strong> in der Einführungsphase in den Kernfächern Deutsch, Mathematik, Englisch und in Sport</li>
      <li><strong>Eine neue Schule, aber vertraute Gesichter:</strong> Klassenbildung mit Blick auf die Herkunftsschule und persönliche Wünsche</li>
      <li><strong>Vertiefungskurse</strong> in den Fächern Deutsch, Mathematik und Englisch</li>
      <li><strong>Anfängerkurse</strong> in Französisch und Latein (ggf. Erwerb des Kleinen Latinums)</li>
      <li><strong>Fortsetzung</strong> von Französisch aus der Sekundarstufe I, sofern genügend Schülerinnen und Schüler es wählen</li>
      <li><strong>Leistungskurse</strong> in Deutsch, Englisch, Mathematik, Erziehungswissenschaft, Sozialwissenschaften, Chemie, Geschichte und Biologie</li>
      <li><strong>Projektkurse</strong> in der Q2 aus unterschiedlichen Aufgabenfeldern, neu ab 2027/28</li>
    </ul>
  </div>
</section>

<section class="ob-sect" aria-label="Wir unterstützen und fördern">
  <div class="container">
    <div class="head">
      <span class="eyebrow">Unterstützung &amp; Förderung</span>
      <h2>Fordern und fördern</h2>
    </div>
    <ul class="ob-check">
      <li>Qualitativer Unterricht, der gymnasiale Standards vermittelt, aber die unterschiedlichen Voraussetzungen und Schulbiografien im Blick behält</li>
      <li>Progressive (stetig ansteigende) Anforderungsprofile in Klausuren und Prüfungen</li>
      <li>Intensive individuelle Beratung und Betreuung durch die Stufenleiterinnen und Stufenleiter</li>
      <li>Initiierung und Betreuung von Lerngruppen</li>
      <li>Förderung von besonderen Stärken</li>
      <li>Vermittlung von Stipendien</li>
      <li>Unterstützung bei der Beantragung von Mitteln zur Bildung und Teilhabe</li>
      <li>Kennenlern- und Methodentage zu Beginn des Schuljahres</li>
      <li>Unterstützung durch Schulsozialarbeit, Schulpsychologischen Dienst, Berufs- und Studienberatung und Arbeitsagentur</li>
    </ul>
  </div>
</section>

<section class="ob-sect alt" aria-label="Wir lernen digital">
  <div class="container">
    <div class="head">
      <span class="eyebrow">Digitale Schule</span>
      <h2>Wir lernen digital</h2>
    </div>
    <ul class="ob-check">
      <li>Alle Schülerinnen und Schüler erhalten ein <strong>iPad</strong> für die verpflichtende Nutzung im schulischen Bereich</li>
      <li>Für alle gibt es eine digitale <strong>Lern- und Kommunikationsplattform</strong>, auf die nur sie Zugriff haben</li>
      <li>Wir fördern einen ausgewogenen, zielgerichteten und reflektierten Umgang mit digitalen Medien und Werkzeugen</li>
    </ul>
  </div>
</section>

<section class="ob-sect" aria-label="Zusätzliches Angebot">
  <div class="container">
    <div class="head">
      <span class="eyebrow">Studium und Beruf</span>
      <h2>Wir bieten zusätzlich an</h2>
    </div>
    <ul class="ob-check">
      <li><strong>Schülerbetriebspraktikum</strong> oder duales Praktikum in der Einführungs­phase</li>
      <li>Berufs- und Laufbahnberatung in der Schule: wöchentliche Sprechstunden mit der Berufs-/Studienberatung</li>
      <li>Individuelle Beratung durch Mitarbeiter des <strong>BIZ</strong> (Berufs­informations­zentrum)</li>
      <li>Beratung und Information durch <strong>Firmen und Institutionen</strong></li>
      <li>Teilnahme an Informationstagen, schulintern oder an den Universitäten</li>
    </ul>
  </div>
</section>

<section class="ob-steps" id="weg" aria-label="Dein Weg zu uns in 6 Schritten">
  <div class="container">
    <div class="head">
      <span class="eyebrow">Dein Weg zu uns</span>
      <h2>In sechs Schritten<br>in die Oberstufe</h2>
    </div>
    <ol class="steps-list">
      <li>
        <span class="num">01</span>
        <div class="body">
          <h3>Vor der Anmeldung</h3>
          <p><strong>Samstag, 05.12.2026, 10–14 Uhr:</strong> Tag der offenen Tür. <strong>Dienstag, 19.01.2027, 19 Uhr:</strong> Informationsveranstaltung in der Aula. <strong>11.01. bis 11.02.2027:</strong> Schnuppertage. Nach einer telefonischen oder schriftlichen Anfrage nimmst du einen Tag am Unterricht der Jahrgangsstufe teil, mit einem „Stundenplan", der deinen Interessen entspricht.</p>
        </div>
        <span class="when">Dezember bis Februar</span>
      </li>
      <li>
        <span class="num">02</span>
        <div class="body">
          <h3>Die Anmeldung</h3>
          <p>Die Anmeldung erfolgt über die Onlineplattform <strong>www.schulbewerbung.de</strong>. Den Startcodezettel für die Onlineanmeldung erhältst du von deiner jetzigen Schule. Welche Unterlagen du einreichst, erfährst du auf dem Informationsabend am 19.01.2027. Mit der Anmeldung bist du zunächst einmal an unserer Schule aufgenommen.</p>
        </div>
        <span class="when">03.02. bis 05.03.2027</span>
      </li>
      <li>
        <span class="num">03</span>
        <div class="body">
          <h3>Die Fächerwahl</h3>
          <p><strong>Mittwoch, 21.04.2027, 19 Uhr:</strong> Informationsveranstaltung in der Aula. Wir erklären die Fächerwahl und zeigen mögliche Schullaufbahnen. Dort oder in einem individuellen Beratungsgespräch (Termine ab 21.04.2027) erhältst du den Wahlzettel. Pflicht für alle sind Deutsch, Mathematik, Englisch und Sport. Dazu kommen Religion oder Philosophie, Kunst oder Musik, Natur- und Gesellschafts­wissenschaften und, wenn du bisher keine zweite Fremdsprache hattest, Französisch oder Latein als neu einsetzende Fremdsprache. Mit einem weiteren Fach nach Wahl hast du in der EF zehn Grundkurse.</p>
        </div>
        <span class="when">Wahlzettel bis 12.05.2027, 12 Uhr</span>
      </li>
      <li>
        <span class="num">04</span>
        <div class="body">
          <h3>Deine besonderen Wünsche</h3>
          <p>In der EF bilden wir Klassenverbände in Deutsch, Englisch, Mathematik und Sport. Auf dem Wahlzettel gibst du an, mit wem du gerne in eine „Klasse" möchtest oder auch auf gar keinen Fall: wir versuchen, deine Wünsche zu berücksichtigen.</p>
        </div>
        <span class="when">Auf dem Wahlzettel</span>
      </li>
      <li>
        <span class="num">05</span>
        <div class="body">
          <h3>Die endgültige Aufnahme</h3>
          <p>Sobald du dein Abschlusszeugnis mit der Fachoberschulreife mit Qualifikationsvermerk hast, legst du es uns so schnell wie möglich, unbedingt vor Beginn der Sommerferien, in Kopie mit dem Original vor. Kommst du von einem anderen Gymnasium, brauchen wir dein Abgangszeugnis. Dann bist du endgültig Schülerin oder Schüler am UNESCO-Gymnasium. Hat es mit der Qualifikation nicht geklappt oder hast du dich für eine andere Schule entschieden, melde dich bitte bei uns: andere warten vielleicht auf den Platz.</p>
        </div>
        <span class="when">Vor den Sommerferien</span>
      </li>
      <li>
        <span class="num">06</span>
        <div class="body">
          <h3>Der erste Schultag</h3>
          <p>Dein erster Schultag an der UNESCO-Schule ist der zweite Schultag nach den Sommerferien. Der gesamte Vormittag gehört dir: Schule, Mitschülerinnen und Mitschüler, Stundenplan, alle Fragen an Klassenleitung und Stufenleitung.</p>
        </div>
        <span class="when">Donnerstag, 02.09.2027</span>
      </li>
    </ol>
  </div>
</section>



