---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { getSingle } from "../lib/pageContent";
import { safeBold } from "../lib/safeMarkup";
import { getTeacherByLastName } from "../lib/teachers";

const page: any = await getSingle("pageSchoolwear");
const introParas: string[] = (page.intro.body ?? "").split(/\n\n+/).map((p: string) => p.trim()).filter(Boolean);

const hoedel = await getTeacherByLastName("Hödel");
const orderMail = hoedel?.data.email ?? "info@unesco-schule-essen.de";
const mailtoHref = `mailto:${orderMail}?subject=${encodeURIComponent("Schoolwear-Bestellung")}`;
---
<BaseLayout title="Schoolwear · UNESCO-Schule Essen" description="Unsere Schoolwear-Kollektion: T-Shirts, Hoodies und Sweatshirtjacken mit Schul-Logo. Anschauen bei Lomestar oder Frau Hödel, bestellt wird per E-Mail bei Frau Hödel.">
<style is:global>
  /* ---------- Schoolwear ---------- */
  .sw-intro{background:var(--creme);padding:var(--space-section) 0;}
  .sw-grid{
    display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);
    gap:56px;align-items:start;
  }
  .sw-grid h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.4vw,44px);line-height:1.1;
    color:var(--petrol);letter-spacing:-0.015em;margin:0;
  }
  .sw-grid h2 em{font-style:italic;color:var(--bordeaux);}
  .sw-grid p{
    font-family:var(--sans);font-size:17px;line-height:1.7;color:var(--tinte);
    margin:0 0 16px;
  }
  .sw-grid strong{color:var(--petrol);}

  /* Galerie */
  .sw-gallery{background:var(--offwhite);padding:var(--space-section) 0;border-top:1px solid var(--hairline);}
  .sw-gallery .head{max-width:820px;margin:0 0 40px;}
  .sw-gallery .head .eyebrow{display:block;margin-bottom:14px;}
  .sw-gallery .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(28px,3vw,40px);line-height:1.15;letter-spacing:-0.015em;
    color:var(--petrol);margin:0 0 14px;
  }
  .sw-gallery .head p{
    font-family:var(--sans);font-size:16.5px;line-height:1.65;color:var(--stein);max-width:640px;margin:0;
  }
  .sw-gallery-grid{
    display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);
    grid-template-rows:1fr 1fr;
    gap:20px;
  }
  .sw-gallery-grid figure{margin:0;position:relative;overflow:hidden;}
  .sw-gallery-grid figure:first-child{grid-row:1 / span 2;}
  .sw-gallery-grid img{
    width:100%;height:100%;object-fit:cover;display:block;
  }
  .sw-gallery-grid figcaption{
    position:absolute;left:0;right:0;bottom:0;
    padding:28px 18px 14px;
    font-family:var(--sans);font-size:13.5px;line-height:1.4;color:#fff;
    background:linear-gradient(to top, rgba(20,30,32,0.72), rgba(20,30,32,0));
  }

  /* Action */
  .sw-action{
    background:var(--petrol);color:var(--creme);
    padding:var(--space-section) 0;
  }
  .sw-action .container{max-width:840px;text-align:center;}
  .sw-action .eyebrow{color:rgba(245,239,231,0.55);display:block;margin-bottom:14px;}
  .sw-action h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(28px,3vw,42px);line-height:1.2;
    color:var(--creme);letter-spacing:-0.015em;margin:0 0 18px;
  }
  .sw-action p{
    font-family:var(--sans);font-size:17px;line-height:1.7;
    color:rgba(245,239,231,0.9);max-width:640px;margin:0 auto 28px;
  }
  .sw-action .btn-row{
    display:flex;flex-wrap:wrap;gap:14px;justify-content:center;align-items:center;
  }
  .sw-btn{
    display:inline-flex;align-items:center;gap:10px;
    padding:16px 28px;
    background:var(--gold);color:var(--gold-text);
    font-family:var(--sans);font-weight:600;font-size:15px;
    text-decoration:none;letter-spacing:0.02em;
    transition:background var(--transition-fast), transform var(--transition-fast);
  }
  .sw-btn:hover{background:var(--gold-hover);transform:translateY(-1px);color:var(--gold-text);}
  .sw-btn-secondary{
    display:inline-flex;align-items:center;gap:10px;
    padding:15px 26px;
    background:transparent;color:var(--creme);
    border:1px solid rgba(245,239,231,0.45);
    font-family:var(--sans);font-weight:600;font-size:15px;
    text-decoration:none;letter-spacing:0.02em;
    transition:border-color var(--transition-fast), background var(--transition-fast);
  }
  .sw-btn-secondary:hover{border-color:var(--creme);background:rgba(245,239,231,0.08);color:var(--creme);}
  @media (prefers-reduced-motion: reduce){.sw-btn:hover{transform:none;}}
  .sw-btn svg,.sw-btn-secondary svg{width:16px;height:16px;flex:none;}
  .sw-action .hint{
    font-family:var(--sans);font-size:13px;color:rgba(245,239,231,0.65);
    margin-top:18px;
  }

  @media (max-width:900px){
    .sw-gallery-grid{grid-template-columns:1fr;grid-template-rows:none;}
    .sw-gallery-grid figure:first-child{grid-row:auto;}
    .sw-gallery-grid figure{aspect-ratio:16/10;}
    .sw-gallery-grid figure:first-child{aspect-ratio:4/5;max-height:520px;}
  }
  @media (max-width:640px){
    .sw-grid{grid-template-columns:1fr;gap:28px;}
    .sw-intro,.sw-gallery,.sw-action{padding:var(--space-section-sm) 0;}
    .sw-action .btn-row{flex-direction:column;}
  }
</style>

<main id="top">

<PageHero variant="feature">
  <Fragment slot="eyebrow">{page.hero.eyebrow}</Fragment>
  <Fragment slot="title">{page.hero.title}{page.hero.titleHighlight && <> <em>{page.hero.titleHighlight}</em></>}</Fragment>
  <Fragment slot="lede">{page.hero.lede}</Fragment>
</PageHero>

<section class="sw-intro" aria-label="Überblick">
  <div class="container">
    <div class="sw-grid">
      <div>
        <h2>{page.intro.title} <em>{page.intro.titleHighlight}</em></h2>
      </div>
      <div>
        {introParas.map((p) => <p set:html={safeBold(p)} />)}
      </div>
    </div>
  </div>
</section>

{page.gallery?.items?.length > 0 && (
  <section class="sw-gallery" aria-label="Fotos: Schoolwear unterwegs">
    <div class="container">
      <div class="head">
        <span class="eyebrow">{page.gallery.eyebrow}</span>
        <h2>{page.gallery.title}</h2>
        <p>{page.gallery.body}</p>
      </div>
      <div class="sw-gallery-grid">
        {page.gallery.items.map((item: any) => (
          <figure>
            <img src={item.src} alt={item.alt} loading="lazy" />
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<section class="sw-action" aria-label="Anschauen und bestellen">
  <div class="container">
    <span class="eyebrow">{page.action.eyebrow}</span>
    <h2>{page.action.title}</h2>
    <p>{page.action.body}</p>
    <div class="btn-row">
      <a href={mailtoHref} class="sw-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {page.action.buttonLabel}
      </a>
      <a href={page.action.secondaryUrl} class="sw-btn-secondary" target="_blank" rel="noopener">
        {page.action.secondaryLabel}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M17 7H9M17 7v8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    <p class="hint">{page.action.hint}</p>
  </div>
</section>

</main>
</BaseLayout>
