---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactCard from "../components/ContactCard.astro";
import { getSingle } from "../lib/pageContent";
import { getTeacherByRole, ROLES } from "../lib/roles";
import { safeBold } from "../lib/safeMarkup";

const page: any = await getSingle("pageLesefoerderung");
const beauftragte = await getTeacherByRole(ROLES.BEAUFTRAGTE_LESEFOERDERUNG_SI);

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
function link(p: string): string {
  const clean = p.startsWith("/") ? p.slice(1) : p;
  return BASE + "/" + clean;
}
---
<BaseLayout
  title="Leseförderung · UNESCO-Schule Essen"
  description="Leseförderung in der Sekundarstufe I der UNESCO-Schule Essen: Bausteine nach Jahrgangsstufen, offener Bücherschrank, Vernetzung mit Stadtbibliothek, Stiftung Lesen und lit.COLOGNE/lit.RUHR."
>
<style is:global>
  /* ---------- Leseförderung ---------- */

  /* Heine-Zitat als Petrol-Akzent */
  .lf-quote{
    background:var(--petrol);color:var(--creme);
    padding:var(--space-section-sm) 0;
  }
  .lf-quote blockquote{
    margin:0 auto;max-width:840px;text-align:center;
    font-family:var(--serif);font-style:italic;font-weight:500;
    font-size:clamp(22px,2.6vw,32px);line-height:1.35;
    color:var(--creme);letter-spacing:-0.005em;
  }
  .lf-quote cite{
    display:block;margin-top:18px;font-style:normal;
    font-family:var(--sans);font-size:11.5px;font-weight:600;
    letter-spacing:0.18em;text-transform:uppercase;
    color:var(--gold);
  }

  /* Bausteine */
  .lf-bausteine{background:var(--creme);padding:var(--space-section) 0;}
  .lf-bausteine .head{max-width:820px;margin:0 0 56px;}
  .lf-bausteine .head .eyebrow{display:block;margin-bottom:14px;}
  .lf-bausteine .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.2vw,44px);line-height:1.15;letter-spacing:-0.015em;
    color:var(--petrol);margin:0 0 16px;
  }
  .lf-bausteine .head p{
    font-family:var(--sans);font-size:17px;line-height:1.65;color:var(--stein);
    max-width:680px;margin:0;
  }
  .lf-stages{
    display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;
  }
  .lf-stage{
    background:#fff;border:1px solid var(--hairline);
    border-top:var(--card-accent-width) solid var(--petrol);
    padding:var(--card-padding);
    display:flex;flex-direction:column;gap:14px;
    transition:transform var(--transition), box-shadow var(--transition);
  }
  .lf-stage:hover{
    transform:translateY(var(--card-hover-lift));
    box-shadow:0 16px 40px -22px rgba(14,77,79,0.3);
  }
  @media (prefers-reduced-motion: reduce){.lf-stage:hover{transform:none;}}
  .lf-stage .klasse{
    font-family:var(--sans);font-size:11px;font-weight:600;
    letter-spacing:0.14em;text-transform:uppercase;color:var(--petrol);
  }
  .lf-stage h3{
    font-family:var(--serif);font-weight:500;font-size:22px;line-height:1.25;
    color:var(--petrol);letter-spacing:-0.01em;margin:2px 0 4px;
  }
  .lf-stage h3 em{font-style:italic;color:var(--bordeaux);}
  .lf-stage ul{
    list-style:none;margin:0;padding:0;
    display:flex;flex-direction:column;gap:10px;
  }
  .lf-stage ul li{
    font-family:var(--sans);font-size:15px;line-height:1.6;color:var(--tinte);
    padding-left:14px;position:relative;
  }
  .lf-stage ul li::before{
    content:"";
    position:absolute;left:0;top:9px;
    width:6px;height:6px;border-radius:50%;background:var(--bordeaux);
  }
  .lf-stage ul li strong{color:var(--petrol);font-weight:500;}

  /* Über das Pflichtprogramm hinaus */
  .lf-beyond{background:var(--offwhite);padding:var(--space-section) 0;border-top:1px solid var(--hairline);}
  .lf-beyond .head{max-width:820px;margin:0 0 48px;}
  .lf-beyond .head .eyebrow{
    display:block;margin-bottom:14px;
    font-size:15px;letter-spacing:0.08em;color:var(--petrol);font-weight:600;
  }
  .lf-beyond .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.2vw,44px);line-height:1.15;letter-spacing:-0.015em;
    color:var(--petrol);margin:0;
  }
  .lf-beyond-grid{
    display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;
  }
  .lf-card{
    background:#fff;border:1px solid var(--hairline);
    border-left:var(--card-accent-width) solid var(--gold);
    padding:var(--card-padding);
    display:flex;flex-direction:column;gap:12px;
  }
  .lf-card h3{
    font-family:var(--serif);font-weight:500;font-size:22px;line-height:1.25;
    color:var(--petrol);letter-spacing:-0.008em;margin:0;
  }
  .lf-card p{
    font-family:var(--sans);font-size:15.5px;line-height:1.7;color:var(--tinte);margin:0;
  }
  .lf-card p strong{color:var(--petrol);font-weight:500;}

  /* Verantwortung */
  .lf-verantwortung{background:var(--creme);padding:var(--space-section) 0;border-top:1px solid var(--hairline);}
  .lf-verantwortung-grid{
    display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);
    gap:48px;align-items:start;
  }
  .lf-verantwortung .eyebrow{display:block;margin-bottom:14px;}
  .lf-verantwortung h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(28px,2.8vw,38px);line-height:1.2;letter-spacing:-0.015em;
    color:var(--petrol);margin:0 0 14px;
  }
  .lf-verantwortung p{
    font-family:var(--sans);font-size:17px;line-height:1.7;color:var(--tinte);margin:0;
  }

  /* PDF-Download */
  .lf-download{background:var(--offwhite);padding:var(--space-section-sm) 0;border-top:1px solid var(--hairline);}
  .lf-download-card{
    max-width:780px;margin:0 auto;
    background:#fff;border:1px solid var(--hairline);
    border-top:var(--card-accent-width) solid var(--petrol);
    padding:32px 36px;
    display:grid;grid-template-columns:auto 1fr auto;gap:28px;align-items:center;
  }
  .lf-download-card .icon{
    width:48px;height:48px;
    background:rgba(14,77,79,0.08);color:var(--petrol);
    display:flex;align-items:center;justify-content:center;
    border-radius:50%;
  }
  .lf-download-card .icon svg{width:22px;height:22px;}
  .lf-download-card .text{display:flex;flex-direction:column;gap:4px;}
  .lf-download-card .eyebrow{display:block;margin-bottom:0;}
  .lf-download-card h3{
    font-family:var(--serif);font-weight:500;font-size:20px;line-height:1.25;
    color:var(--petrol);letter-spacing:-0.008em;margin:0;
  }
  .lf-download-card .meta{
    font-family:var(--sans);font-size:13px;color:var(--stein);letter-spacing:0.04em;
  }
  .lf-download-card .btn{white-space:nowrap;}

  /* Closing */
  .lf-closing{
    background:var(--petrol);color:var(--creme);
    padding:var(--space-section) 0;
  }
  .lf-closing .container{max-width:840px;text-align:center;}
  .lf-closing .eyebrow{color:rgba(245,239,231,0.55);display:block;margin-bottom:16px;}
  .lf-closing h2{
    font-family:var(--serif);font-weight:500;font-style:italic;
    font-size:clamp(28px,3.2vw,44px);line-height:1.2;
    color:var(--creme);letter-spacing:-0.015em;margin:0 0 26px;
  }
  .lf-closing h2 em{color:var(--gold);font-style:italic;}
  .lf-closing p{
    font-family:var(--sans);font-size:17.5px;line-height:1.7;
    color:rgba(245,239,231,0.9);max-width:720px;margin:0 auto;
  }

  @media (max-width:960px){
    .lf-stages{grid-template-columns:1fr;gap:16px;}
    .lf-beyond-grid{grid-template-columns:1fr;gap:16px;}
    .lf-verantwortung-grid{grid-template-columns:1fr;gap:24px;}
    .lf-download-card{
      grid-template-columns:auto 1fr;gap:20px;padding:28px;
    }
    .lf-download-card .btn{grid-column:1 / -1;}
    .lf-bausteine,.lf-beyond,.lf-verantwortung,.lf-closing{padding:var(--space-section-sm) 0;}
  }
  @media (max-width:560px){
    .lf-download-card{grid-template-columns:1fr;text-align:center;}
    .lf-download-card .icon{margin:0 auto;}
  }
</style>

<main id="top">

<PageHero variant="feature" image="assets/hero/lesefoerderung.jpg" imageAlt="Hände beim Schreiben und Lesen">
  <Fragment slot="eyebrow">{page.hero.eyebrow}</Fragment>
  <Fragment slot="title">{page.hero.title}{page.hero.titleHighlight && <><br /><em>{page.hero.titleHighlight}</em></>}</Fragment>
  <Fragment slot="lede">{page.hero.lede}</Fragment>
</PageHero>

<section class="lf-quote" aria-label="Zitat Heinrich Heine">
  <div class="container">
    <blockquote>„{page.quote?.text}"<cite>{page.quote?.author}</cite></blockquote>
  </div>
</section>

<section class="lf-bausteine" aria-label="Bausteine nach Jahrgangsstufen">
  <div class="container">
    <div class="head">
      {page.bausteine?.eyebrow && <span class="eyebrow">{page.bausteine.eyebrow}</span>}
      <h2>{page.bausteine?.title}</h2>
      {page.bausteine?.body && <p>{page.bausteine.body}</p>}
    </div>
    <div class="lf-stages">
      {(page.bausteine?.list ?? []).map((s: any) => (
        <article class="lf-stage">
          <span class="klasse">{s.klasse}</span>
          <h3><em>{s.mark}</em></h3>
          <ul>
            {(s.bullets ?? []).map((b: string) => (
              <li set:html={safeBold(b)} />
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="lf-beyond" aria-label="Über das Pflichtprogramm hinaus">
  <div class="container">
    <div class="head">
      {page.beyond?.eyebrow && <span class="eyebrow">{page.beyond.eyebrow}</span>}
      {page.beyond?.title && <h2>{page.beyond.title}</h2>}
    </div>
    <div class="lf-beyond-grid">
      {(page.beyond?.cards ?? []).map((c: any) => (
        <article class="lf-card">
          <h3>{c.title}</h3>
          <p set:html={safeBold(c.body)} />
        </article>
      ))}
    </div>
  </div>
</section>

<section class="lf-verantwortung" aria-label="Beauftragte für Leseförderung">
  <div class="container">
    <div class="lf-verantwortung-grid">
      <div>
        {page.verantwortung?.eyebrow && <span class="eyebrow">{page.verantwortung.eyebrow}</span>}
        <h2>{page.verantwortung?.title}</h2>
        <p>{page.verantwortung?.body}</p>
      </div>
      <div>
        {beauftragte ? (
          <ContactCard
            teacher={beauftragte}
            roleLabel="Beauftragte Leseförderung Sek I"
            ctaLabel="E-Mail an die Leseförderung"
          />
        ) : (
          <p style="font-style:italic;color:var(--stein);">Stelle aktuell vakant. Wenden Sie sich gerne an das Sekretariat.</p>
        )}
      </div>
    </div>
  </div>
</section>

<section class="lf-download" aria-label="PDF-Download">
  <div class="container">
    <a class="lf-download-card" href={link(page.download?.fileHref ?? "")} download>
      <span class="icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/>
          <path d="M14 3v5h5"/>
          <path d="M12 12v6m-3-3l3 3 3-3"/>
        </svg>
      </span>
      <div class="text">
        {page.download?.eyebrow && <span class="eyebrow">{page.download.eyebrow}</span>}
        <h3>{page.download?.title}</h3>
        <span class="meta">{page.download?.fileLabel}</span>
      </div>
      <span class="btn btn-primary">PDF öffnen <span class="arrow">→</span></span>
    </a>
  </div>
</section>

<section class="lf-closing" aria-label="Abschluss">
  <div class="container">
    {page.closing?.eyebrow && <span class="eyebrow">{page.closing.eyebrow}</span>}
    <h2>{page.closing?.title}{page.closing?.titleHighlight && <><br /><em>{page.closing.titleHighlight}</em></>}</h2>
    <p>{page.closing?.body}</p>
  </div>
</section>

</main>
</BaseLayout>
