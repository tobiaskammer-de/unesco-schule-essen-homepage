---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import MailLink from "../components/MailLink.astro";
import { getTeacherByRole, ROLES } from "../lib/roles";
import { displayName, initials } from "../lib/teachers";
import { getSingle } from "../lib/pageContent";

const page: any = await getSingle("pageSchulleitung");

const [schulleiterin, stellv, koordEprob, koordMittelstufe, koordOberstufe] = await Promise.all([
  getTeacherByRole(ROLES.SCHULLEITUNG),
  getTeacherByRole(ROLES.STELLV_SCHULLEITUNG),
  getTeacherByRole(ROLES.KOORD_ERPROBUNGSSTUFE),
  getTeacherByRole(ROLES.KOORD_MITTELSTUFE),
  getTeacherByRole(ROLES.KOORD_OBERSTUFE),
]);

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
function asset(p?: string | null): string | undefined {
  if (!p) return undefined;
  if (/^https?:\/\//.test(p)) return p;
  if (p.startsWith(BASE + "/") || p.startsWith(BASE)) return p;
  if (p.startsWith("/")) return BASE && !p.startsWith(BASE) ? BASE + p : p;
  return BASE + "/" + p;
}

const leadership = [
  { teacher: schulleiterin, role: "Schulleiterin" },
  { teacher: stellv,        role: "Stellvertretende Schulleitung" },
].filter((c) => c.teacher);

const koordinationen = [
  { teacher: koordEprob,       role: "Koordination · Erprobungsstufe" },
  { teacher: koordMittelstufe, role: "Koordination · Mittelstufe" },
  { teacher: koordOberstufe,   role: "Koordination · Oberstufe" },
].filter((c) => c.teacher);
---
<BaseLayout title="Schulleitung · UNESCO-Schule Essen">
<style is:global>
  /* ---------- Schulleitung ---------- */
  .sl-team{background:var(--offwhite);padding:var(--space-section) 0;}
  .sl-team .head{max-width:760px;margin:0 0 48px;}
  .sl-team .head .eyebrow{display:block;margin-bottom:14px;}
  .sl-team .head h2{
    font-family:var(--serif);font-weight:500;
    font-size:clamp(30px,3.2vw,44px);line-height:1.15;letter-spacing:-0.015em;
    color:var(--petrol);margin:0;
  }

  .sl-grid{
    display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;
  }
  .sl-grid--two{
    grid-template-columns:repeat(2,minmax(0,1fr));
    max-width:calc(66.66% - 8px);
    margin-bottom:24px;
  }

  .sl-card{
    background:#fff;
    border:1px solid var(--hairline);
    border-radius:14px;
    padding:32px 28px 28px;
    display:flex;flex-direction:column;align-items:center;text-align:center;gap:14px;
    box-shadow:0 6px 18px -10px rgba(14,77,79,0.18);
    transition:transform var(--transition), box-shadow var(--transition);
  }
  .sl-card:hover{
    transform:translateY(-2px);
    box-shadow:0 14px 28px -14px rgba(14,77,79,0.28);
  }
  @media (prefers-reduced-motion: reduce){.sl-card:hover{transform:none;}}

  .sl-card .avatar{
    width:104px;height:104px;border-radius:50%;overflow:hidden;
    background:var(--petrol);
    display:flex;align-items:center;justify-content:center;
    font-family:var(--serif);font-weight:500;font-size:32px;color:var(--creme);
    letter-spacing:-0.01em;flex-shrink:0;
  }
  .sl-card .avatar img{width:100%;height:100%;object-fit:cover;display:block;}

  .sl-card .role{
    font-family:var(--sans);font-size:11px;font-weight:600;
    letter-spacing:0.14em;text-transform:uppercase;color:var(--bordeaux);
    margin:0;
  }
  .sl-card .name{
    font-family:var(--serif);font-weight:500;font-size:22px;line-height:1.2;
    color:var(--petrol);letter-spacing:-0.008em;margin:0;
  }
  .sl-card .mail{
    margin-top:auto;
    font-family:var(--sans);font-size:13.5px;color:var(--petrol);
    text-decoration:none;
    border-bottom:1px solid var(--hairline);padding-bottom:2px;
    transition:border-color var(--transition-fast), color var(--transition-fast);
    word-break:break-all;
  }
  .sl-card .mail:hover{border-bottom-color:var(--petrol);color:var(--petrol-dark);}

  @media (max-width:900px){
    .sl-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;}
    .sl-grid--two{max-width:none;}
  }
  @media (max-width:560px){
    .sl-grid{grid-template-columns:1fr;}
    .sl-team{padding:var(--space-section-sm) 0;}
  }
</style>

<main id="top">

<PageHero variant="page">
  <Fragment slot="eyebrow">{page.hero.eyebrow}</Fragment>
  <Fragment slot="title">{page.hero.title}</Fragment>
  {page.hero.lede && <Fragment slot="lede">{page.hero.lede}</Fragment>}
</PageHero>

<section class="sl-team" aria-label="Schulleitung und Koordination">
  <div class="container">
    <div class="sl-grid sl-grid--two">
      {leadership.map(({ teacher, role }) => (
        <article class="sl-card">
          <div class="avatar">
            {asset(teacher!.data.photo)
              ? <img src={asset(teacher!.data.photo)} alt="" loading="lazy" width="104" height="104" />
              : <span>{initials(teacher!)}</span>}
          </div>
          <p class="role">{role}</p>
          <h3 class="name">{displayName(teacher!)}</h3>
          <MailLink class="mail" email={teacher!.data.email} />
        </article>
      ))}
    </div>

    <div class="sl-grid">
      {koordinationen.map(({ teacher, role }) => (
        <article class="sl-card">
          <div class="avatar">
            {asset(teacher!.data.photo)
              ? <img src={asset(teacher!.data.photo)} alt="" loading="lazy" width="104" height="104" />
              : <span>{initials(teacher!)}</span>}
          </div>
          <p class="role">{role}</p>
          <h3 class="name">{displayName(teacher!)}</h3>
          <MailLink class="mail" email={teacher!.data.email} />
        </article>
      ))}
    </div>
  </div>
</section>

</main>
</BaseLayout>
