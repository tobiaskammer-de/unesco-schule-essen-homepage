---
/**
 * Schmale Hinweisleiste zum Tag der offenen Tür über dem Seitenkopf.
 * Wird nur gerendert, solange der Termin bevorsteht (siehe lib/openDay.ts),
 * lässt sich wegklicken (pro Termin, im Browser gemerkt) und verschwindet
 * nach dem Ende auch ohne neuen Build.
 */
import { openDay } from "../lib/openDay";

interface Props { href: string }
const { href } = Astro.props;
const storageKey = `openDayBarDismissed:${openDay.endsAt}`;
---
<div class="od-bar" id="openDayBar" role="region" aria-label="Hinweis: Tag der offenen Tür" data-pagefind-ignore>
  <a class="od-bar-link" href={href}>
    <span class="od-dot" aria-hidden="true"></span>
    <strong>Tag der offenen Tür</strong>
    <span class="od-sep" aria-hidden="true">·</span>
    <span class="od-long">{openDay.dateLong}, {openDay.time}</span>
    <span class="od-short">{openDay.dateShort}, {openDay.timeShort}</span>
    <span class="od-sep od-long" aria-hidden="true">·</span>
    <span class="od-cta"><span class="od-long">Programm ansehen</span> <span aria-hidden="true">→</span></span>
  </a>
  <button type="button" class="od-close" aria-label="Hinweis zum Tag der offenen Tür schließen">×</button>
</div>
<script is:inline define:vars={{ endsAt: openDay.endsAt, storageKey }}>
  (function(){
    var bar = document.getElementById("openDayBar");
    if (!bar) return;
    var dismissed = false;
    try { dismissed = localStorage.getItem(storageKey) === "1"; } catch (e) {}
    if (dismissed || Date.now() >= new Date(endsAt).getTime()) { bar.remove(); return; }

    // Das Handy-Menü hängt am Seitenkopf und ist so hoch wie der Bildschirm
    // minus Kopf. Solange die Leiste darüber sichtbar ist, liegt der Kopf
    // tiefer; damit das Menü unten nicht abgeschnitten wird, Höhe begrenzen.
    function fitNav(){
      var header = document.getElementById("siteHeader");
      var nav = document.querySelector(".main-nav");
      if (!header || !nav) return;
      var vh = Math.min(window.innerHeight, document.documentElement.clientHeight);
      var free = vh - header.getBoundingClientRect().bottom;
      nav.style.maxHeight = Math.max(200, Math.round(free)) + "px";
    }
    window.addEventListener("scroll", fitNav, { passive: true });
    window.addEventListener("resize", fitNav);
    document.addEventListener("DOMContentLoaded", fitNav);

    bar.querySelector(".od-close").addEventListener("click", function(){
      try { localStorage.setItem(storageKey, "1"); } catch (e) {}
      bar.remove();
      window.removeEventListener("scroll", fitNav);
      window.removeEventListener("resize", fitNav);
      var nav = document.querySelector(".main-nav");
      if (nav) nav.style.maxHeight = "";
    });
  })();
</script>

<style is:global>
  .od-bar{
    position:relative;
    background:var(--petrol-dark);color:var(--creme);
    font-family:var(--sans);font-size:14px;line-height:1.4;
  }
  .od-bar-link{
    display:flex;align-items:center;justify-content:center;flex-wrap:wrap;
    gap:4px 10px;
    min-height:44px;padding:10px 56px;
    color:inherit;text-decoration:none;text-align:center;
  }
  .od-bar-link strong{font-weight:600;color:#fff;}
  .od-sep{color:rgba(245,239,231,0.45);}
  .od-cta{color:var(--gold);font-weight:600;white-space:nowrap;}
  .od-bar-link:hover .od-cta,
  .od-bar-link:focus-visible .od-cta{text-decoration:underline;text-underline-offset:3px;}
  .od-bar-link:focus-visible{outline:2px solid var(--gold);outline-offset:-4px;}
  .od-dot{
    width:8px;height:8px;border-radius:50%;background:var(--gold);flex:none;
    box-shadow:0 0 0 0 rgba(212,165,116,0.6);
    animation:odPulse 2.4s ease-out infinite;
  }
  @keyframes odPulse{
    0%{box-shadow:0 0 0 0 rgba(212,165,116,0.55);}
    70%{box-shadow:0 0 0 8px rgba(212,165,116,0);}
    100%{box-shadow:0 0 0 0 rgba(212,165,116,0);}
  }
  @media (prefers-reduced-motion: reduce){ .od-dot{animation:none;} }
  .od-close{
    position:absolute;right:8px;top:50%;transform:translateY(-50%);
    width:40px;height:40px;border:0;border-radius:50%;
    background:transparent;color:var(--creme);
    font-size:22px;line-height:1;cursor:pointer;
  }
  .od-close:hover{background:rgba(245,239,231,0.12);}
  .od-close:focus-visible{outline:2px solid var(--gold);outline-offset:0;}
  .od-short{display:none;}
  @media (max-width:640px){
    .od-bar{font-size:13px;}
    .od-bar-link{padding:10px 44px 10px 16px;justify-content:flex-start;text-align:left;gap:4px 7px;flex-wrap:nowrap;white-space:nowrap;}
    .od-long{display:none;}
    .od-short{display:inline;}
  }
  @media print{ .od-bar{display:none;} }
</style>
